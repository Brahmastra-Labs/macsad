# MaCSad public research ledger composition

Import PublicationPolicy from "./publication_policy.lg".
Import PublicationRail from "./publication_rail.lg".
Import ResearchHeading from "./research_heading.lg".
Import ResearchRecord from "./research_record.lg".
Import ResearchSelection from "./research_selection.lg".

## Component ResearchLedger

State:
    Let publicationReady be publicationVisible(false, false).

View:
    <section aria-label="Public research ledger">
      <ResearchHeading/>
      <ResearchSelection/>
      <div class="feature-grid">
        <ResearchRecord publicationReady={publicationReady}/>
        <PublicationRail/>
      </div>
    </section>

Style:
    .feature-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(min(280px,100%),1fr));
        gap: 16px;
    }
