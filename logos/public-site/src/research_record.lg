# Public example record

Import EvidenceRequirements from "./evidence_requirements.lg".

## Component ResearchRecord (publicationReady: Bool)

View:
    <article class="research-card">
      <div class="record-line">
        {if publicationReady:}
          <span class="badge badge-muted">Reviewed record</span>
        {else:}
          <span class="badge badge-muted">Template record</span>
        {end}
      </div>
      <h3>A publication slot reserved for the first reviewed result.</h3>
      <p class="abstract">When the sealed batch is enabled, this card will be generated from approved publication records—not from live administrative data and never directly from an agent chat.</p>
      <EvidenceRequirements/>
      <div class="notice">Example only · this template is not a scientific claim and contains no generated research output.</div>
    </article>

Style:
    .research-card {
        padding: clamp(24px,4vw,42px);
        background: #fffdf8;
        border: 1px solid #d7d2c6;
        border-radius: 17px;
        box-shadow: 0 14px 42px rgba(16,44,59,.06);
    }
    .record-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 25px;
    }
    .badge {
        padding: 6px 8px;
        color: #12687a;
        background: #e4f2f3;
        border-radius: 6px;
        font: 800 9px/1 ui-monospace, monospace;
        letter-spacing: .1em;
        text-transform: uppercase;
    }
    .badge-muted {
        color: #6e685c;
        background: #eee9dd;
    }
    .research-card h3 {
        max-width: 760px;
        margin: 0;
        color: #183440;
        font: 720 clamp(25px,3.5vw,42px)/1.12 Georgia, serif;
        letter-spacing: -.025em;
    }
    .abstract {
        margin: 20px 0 0;
        color: #5c696f;
        font-size: 14px;
        line-height: 1.75;
    }
    .notice {
        margin-top: 25px;
        padding: 15px;
        color: #5d5648;
        background: #faf4df;
        border-left: 3px solid #d9a72e;
        font-size: 12px;
        line-height: 1.6;
    }
