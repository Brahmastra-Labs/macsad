diff --git a/tools/lean-bridge/CoreExport.lean b/tools/lean-bridge/CoreExport.lean
new file mode 100644
index 0000000000000000000000000000000000000000..1e50f268b5fd30790f54a65e686ace2f6019d4fd
--- /dev/null
+++ b/tools/lean-bridge/CoreExport.lean
@@ -0,0 +1,313 @@
+import Lean
+import Lean.Elab.Frontend
+import Lean.Util.CollectAxioms
+
+/-
+Trusted-fixture transport only. The generic walker exports the actual kernel
+environment; it neither translates Lean nor decides mathematical acceptance.
+No uploaded source, path, project, plugin, or dependency argument is accepted.
+-/
+namespace MaCSad.LeanExport
+open Lean
+
+def maxNodes : Nat := 4096
+def maxDeclarations : Nat := 32
+def maxDepth : Nat := 512
+def maxSourceBytes : Nat := 32768
+def maxOutputBytes : Nat := 262144
+
+def str (s : String) : Json := .str s
+def num (n : Nat) : Json := toJson n
+def decimal (n : Nat) : Json := str (toString n)
+def obj (fields : List (String × Json)) : Json := Json.mkObj fields
+
+def nameJson : Name → Json
+  | .anonymous => obj [("tag", str "anonymous")]
+  | .str parentName value => obj [("tag", str "str"), ("prefix", nameJson parentName), ("value", str value)]
+  | .num parentName value => obj [("tag", str "num"), ("prefix", nameJson parentName), ("value", decimal value)]
+
+def namesJson (names : List Name) : Json := .arr (names.toArray.map nameJson)
+
+def levelJson : Nat → Nat → Level → Except String (Json × Nat)
+  | 0, _, _ => .error "resource-limit: universe depth"
+  | _, 0, _ => .error "resource-limit: expanded universe nodes"
+  | fuel + 1, budget + 1, level => do
+    match level with
+    | .zero => return (obj [("tag", str "zero")], budget)
+    | .succ child =>
+      let (child, rest) ← levelJson fuel budget child
+      return (obj [("tag", str "succ"), ("child", child)], rest)
+    | .max left right =>
+      let (left, rest) ← levelJson fuel budget left
+      let (right, rest) ← levelJson fuel rest right
+      return (obj [("tag", str "max"), ("left", left), ("right", right)], rest)
+    | .imax left right =>
+      let (left, rest) ← levelJson fuel budget left
+      let (right, rest) ← levelJson fuel rest right
+      return (obj [("tag", str "imax"), ("left", left), ("right", right)], rest)
+    | .param name => return (obj [("tag", str "param"), ("name", nameJson name)], budget)
+    | .mvar id => return (obj [("tag", str "mvar"), ("name", nameJson id.name)], budget)
+
+def binderJson : BinderInfo → Json
+  | .default => str "default"
+  | .implicit => str "implicit"
+  | .strictImplicit => str "strictImplicit"
+  | .instImplicit => str "instImplicit"
+
+def metadataValueJson : DataValue → Json
+  | .ofString value => obj [("tag", str "string"), ("value", str value)]
+  | .ofBool value => obj [("tag", str "bool"), ("value", toJson value)]
+  | .ofName value => obj [("tag", str "name"), ("value", nameJson value)]
+  | .ofNat value => obj [("tag", str "nat"), ("value", decimal value)]
+  | .ofInt value => obj [("tag", str "int"), ("value", str (toString value))]
+  | .ofSyntax value => obj [("tag", str "syntaxRepr"), ("value", str (reprStr value))]
+
+structure ExportState where
+  nodes : Array Json := #[]
+  references : Array Name := #[]
+  levelBudget : Nat := 4096
+  deriving Inhabited
+
+abbrev ExportM := StateT ExportState (Except String)
+
+def reference (name : Name) : ExportM Unit := do
+  unless (← get).references.contains name do
+    modify fun state => { state with references := state.references.push name }
+
+def pushNode (fields : List (String × Json)) : ExportM Nat := do
+  let state ← get
+  if state.nodes.size ≥ maxNodes then throw "resource-limit: core node count"
+  let id := state.nodes.size + 1
+  set { state with nodes := state.nodes.push (obj (("id", num id) :: fields)) }
+  return id
+
+def liftResult (result : Except String α) : ExportM α :=
+  match result with
+  | .ok value => pure value
+  | .error reason => throw reason
+
+def exportLevel (level : Level) : ExportM Json := do
+  let (result, remaining) ← liftResult (levelJson maxDepth (← get).levelBudget level)
+  modify fun state => { state with levelBudget := remaining }
+  return result
+
+def exprJson : Nat → Expr → ExportM Nat
+  | 0, _ => throw "resource-limit: expression depth"
+  | fuel + 1, expression => do
+    let fields ← match expression with
+      | .bvar index => pure [("tag", str "bvar"), ("index", decimal index)]
+      | .fvar id => pure [("tag", str "fvar"), ("name", nameJson id.name)]
+      | .mvar id => pure [("tag", str "mvar"), ("name", nameJson id.name)]
+      | .sort level => pure [("tag", str "sort"), ("level", ← exportLevel level)]
+      | .const name levels => do
+        reference name
+        let levels ← levels.mapM exportLevel
+        pure [("tag", str "const"), ("name", nameJson name), ("levels", .arr levels.toArray)]
+      | .app function argument => do
+        let functionId ← exprJson fuel function
+        let argumentId ← exprJson fuel argument
+        pure [("tag", str "app"), ("function", num functionId), ("argument", num argumentId)]
+      | .lam name domain body info => do
+        let domainId ← exprJson fuel domain
+        let bodyId ← exprJson fuel body
+        pure [("tag", str "lam"), ("binderName", nameJson name), ("binderInfo", binderJson info),
+          ("domain", num domainId), ("body", num bodyId)]
+      | .forallE name domain body info => do
+        let domainId ← exprJson fuel domain
+        let bodyId ← exprJson fuel body
+        pure [("tag", str "forallE"), ("binderName", nameJson name), ("binderInfo", binderJson info),
+          ("domain", num domainId), ("body", num bodyId)]
+      | .letE name type value body nondep => do
+        let typeId ← exprJson fuel type
+        let valueId ← exprJson fuel value
+        let bodyId ← exprJson fuel body
+        pure [("tag", str "letE"), ("binderName", nameJson name), ("type", num typeId),
+          ("value", num valueId), ("body", num bodyId), ("nondep", toJson nondep)]
+      | .lit (.natVal value) => pure [("tag", str "lit"), ("kind", str "nat"), ("value", decimal value)]
+      | .lit (.strVal value) => pure [("tag", str "lit"), ("kind", str "string"), ("value", str value)]
+      | .mdata data child => do
+        let childId ← exprJson fuel child
+        let entries := data.entries.toArray.map fun (key, value) =>
+          obj [("key", nameJson key), ("value", metadataValueJson value)]
+        pure [("tag", str "mdata"), ("child", num childId), ("entries", .arr entries)]
+      | .proj typeName index structureExpr => do
+        reference typeName
+        let structureId ← exprJson fuel structureExpr
+        pure [("tag", str "proj"), ("typeName", nameJson typeName),
+          ("index", decimal index), ("structure", num structureId)]
+    pushNode fields
+
+def hintsJson : ReducibilityHints → Json
+  | .opaque => obj [("tag", str "opaque")]
+  | .abbrev => obj [("tag", str "abbrev")]
+  | .regular height => obj [("tag", str "regular"), ("height", decimal height.toNat)]
+
+def safetyJson : DefinitionSafety → Json
+  | .safe => str "safe"
+  | .unsafe => str "unsafe"
+  | .partial => str "partial"
+
+def declarationJson (info : ConstantInfo) : ExportM Json := do
+  let typeRoot ← exprJson maxDepth info.type
+  let valueRoot ← match info.value? (allowOpaque := true) with
+    | some value => do
+      let valueId ← exprJson maxDepth value
+      pure (num valueId)
+    | none => pure Json.null
+  let (kind, details) ← match info with
+    | .axiomInfo value => pure ("axiom", obj [("isUnsafe", toJson value.isUnsafe)])
+    | .defnInfo value => do
+      value.all.forM reference
+      pure ("definition", obj [("hints", hintsJson value.hints), ("safety", safetyJson value.safety),
+        ("all", namesJson value.all)])
+    | .thmInfo value => do
+      value.all.forM reference
+      pure ("theorem", obj [("all", namesJson value.all)])
+    | .opaqueInfo value => do
+      value.all.forM reference
+      pure ("opaque", obj [("isUnsafe", toJson value.isUnsafe), ("all", namesJson value.all)])
+    | .quotInfo value =>
+      let kind := match value.kind with
+        | .type => "type" | .ctor => "ctor" | .lift => "lift" | .ind => "ind"
+      pure ("quotient", obj [("kind", str kind)])
+    | .inductInfo value => do
+      value.all.forM reference
+      value.ctors.forM reference
+      pure ("inductive", obj [("numParams", decimal value.numParams), ("numIndices", decimal value.numIndices),
+        ("all", namesJson value.all), ("ctors", namesJson value.ctors), ("numNested", decimal value.numNested),
+        ("isRec", toJson value.isRec), ("isUnsafe", toJson value.isUnsafe), ("isReflexive", toJson value.isReflexive)])
+    | .ctorInfo value => do
+      reference value.induct
+      pure ("constructor", obj [("induct", nameJson value.induct), ("index", decimal value.cidx),
+        ("numParams", decimal value.numParams), ("numFields", decimal value.numFields), ("isUnsafe", toJson value.isUnsafe)])
+    | .recInfo value => do
+      value.all.forM reference
+      let rules ← value.rules.mapM fun rule => do
+        reference rule.ctor
+        let rhsRoot ← exprJson maxDepth rule.rhs
+        pure (obj [("ctor", nameJson rule.ctor), ("numFields", decimal rule.nfields), ("rhsRoot", num rhsRoot)])
+      pure ("recursor", obj [("all", namesJson value.all), ("numParams", decimal value.numParams),
+        ("numIndices", decimal value.numIndices), ("numMotives", decimal value.numMotives),
+        ("numMinors", decimal value.numMinors), ("rules", .arr rules.toArray),
+        ("k", toJson value.k), ("isUnsafe", toJson value.isUnsafe)])
+  return obj [("name", nameJson info.name), ("displayName", str info.name.toString), ("kind", str kind),
+    ("levelParams", namesJson info.levelParams), ("typeRoot", num typeRoot), ("valueRoot", valueRoot),
+    ("details", details)]
+
+def closureJson (environment : Environment) (target : Name) : ExportM (Array Json) := do
+  let mut pending := #[target]
+  let mut declarations := #[]
+  let mut cursor := 0
+  while cursor < pending.size do
+    if cursor ≥ maxDeclarations then throw "resource-limit: declaration closure"
+    let name := pending[cursor]!
+    let some info := environment.checked.get.find? name
+      | throw s!"export-error: checked declaration missing: {name}"
+    declarations := declarations.push (← declarationJson info)
+    for dependency in (← get).references do
+      unless pending.contains dependency do pending := pending.push dependency
+    cursor := cursor + 1
+  return declarations
+
+structure Fixture where
+  id : String
+  fileName : String
+  target : Name
+  source : String
+
+def longCompositionSource : String := Id.run do
+  let mut source := "namespace MaCSadFixture\n\ntheorem long_composition (P : Prop) (step : P → P) (initial : P) : P := by\n"
+  for _ in [0:256] do source := source ++ "  apply step\n"
+  return source ++ "  exact initial\n\nend MaCSadFixture\n"
+
+def fixture? : String → Option Fixture
+  | "identity" => some ⟨"identity", "identity.lean", `MaCSadFixture.identity, include_str "fixtures/identity.lean"⟩
+  | "composition" => some ⟨"composition", "composition.lean", `MaCSadFixture.composition, include_str "fixtures/composition.lean"⟩
+  | "invalid_proof" => some ⟨"invalid_proof", "invalid_proof.lean", `MaCSadFixture.invalid_proof, include_str "fixtures/invalid_proof.lean"⟩
+  | "sorry" => some ⟨"sorry", "sorry.lean", `MaCSadFixture.contains_sorry, include_str "fixtures/sorry.lean"⟩
+  | "axiom_dependency" => some ⟨"axiom_dependency", "axiom_dependency.lean", `MaCSadFixture.assumes, include_str "fixtures/axiom_dependency.lean"⟩
+  | "repeated_binders" => some ⟨"repeated_binders", "repeated_binders.lean", `MaCSadFixture.repeated_binders, include_str "fixtures/repeated_binders.lean"⟩
+  | "long_composition" => some ⟨"long_composition", "long_composition.lean", `MaCSadFixture.long_composition, longCompositionSource⟩
+  | _ => none
+
+def hexBytes (bytes : ByteArray) : String := Id.run do
+  let digits := "0123456789abcdef".toList.toArray
+  let mut result := ""
+  for byte in bytes do
+    result := result.push digits[byte.toNat / 16]!
+    result := result.push digits[byte.toNat % 16]!
+  return result
+
+def severityJson : MessageSeverity → Json
+  | .information => str "information"
+  | .warning => str "warning"
+  | .error => str "error"
+
+def messagesJson (messages : MessageLog) : IO (Array Json) := do
+  let mut result := #[]
+  for message in messages.toList do
+    if result.size ≥ 32 then throw (IO.userError "resource-limit: diagnostic count")
+    let text ← message.data.toString
+    if text.toUTF8.size > 4096 then throw (IO.userError "resource-limit: diagnostic bytes")
+    result := result.push (obj [("severity", severityJson message.severity), ("message", str text)])
+  return result
+
+def envelope (fixture : Fixture) (status : String) (diagnostics : Array Json)
+    (imports : Array Name := #[]) (declarations : Array Json := #[]) (nodes : Array Json := #[])
+    (axioms : Array Name := #[]) (complete := false) : Json :=
+  obj [("schema", str "macsad-lean-core/1"), ("exporterVersion", str "1"),
+    ("compiler", obj [("version", str Lean.versionString), ("gitCommit", str Lean.githash)]),
+    ("source", obj [("fixtureId", str fixture.id), ("fileName", str fixture.fileName),
+      ("byteLength", num fixture.source.toUTF8.size),
+      ("utf8Hex", if fixture.source.toUTF8.size ≤ maxSourceBytes then str (hexBytes fixture.source.toUTF8) else Json.null)]),
+    ("status", str status), ("diagnostics", .arr diagnostics), ("targetName", nameJson fixture.target),
+    ("imports", .arr (imports.map nameJson)), ("declarations", .arr declarations), ("nodes", .arr nodes),
+    ("axiomDependencies", .arr (axioms.map nameJson)), ("closureComplete", toJson complete)]
+
+def errorEnvelope (fixture : Fixture) (status reason : String) : Json :=
+  envelope fixture status #[obj [("severity", str "error"), ("message", str reason)]]
+
+unsafe def exportSource (source fileName : String) (target : Name)
+    (fixtureId := "trusted-source") : IO (UInt32 × Json) := do
+  let fixture : Fixture := ⟨fixtureId, fileName, target, source⟩
+  if Lean.versionString != "4.31.0" || Lean.githash != "68218e876d2a38b1985b8590fff244a83c321783" then
+    return (1, errorEnvelope fixture "export-error" "compiler identity mismatch")
+  if fixture.source.toUTF8.size > maxSourceBytes then
+    return (1, errorEnvelope fixture "resource-limit" "source bytes")
+  -- This loads only the installed compiler's own builtin library. It is not a
+  -- filesystem sandbox; it merely prevents an inherited LEAN_PATH substituting
+  -- imports used when elaborating embedded, reviewed fixture sources.
+  Lean.searchPathRef.set (← Lean.getBuiltinSearchPath (← Lean.getBuildDir))
+  Lean.enableInitializersExecution
+  let options := ({} : Options).setBool `Elab.async false
+    |>.set `maxHeartbeats (200000 : Nat) |>.set `maxRecDepth (2048 : Nat)
+  let initial ← Lean.importModules #[{ module := `Init }] options 0 (loadExts := true)
+  let (environment, messages) ← Lean.Elab.process fixture.source initial options fixture.fileName
+  let diagnostics ← messagesJson messages
+  let imports := environment.imports.map (·.module)
+  if messages.hasErrors then
+    return (1, envelope fixture "elaboration-error" diagnostics imports)
+  let context : Core.Context := { fileName := fixture.fileName, fileMap := FileMap.ofString fixture.source, options }
+  let (axioms, _) ← (Lean.collectAxioms fixture.target : CoreM (Array Name)).toIO context { env := environment }
+  match (closureJson environment fixture.target).run {} with
+  | .error reason =>
+    let status := if reason.startsWith "resource-limit:" then "resource-limit" else "export-error"
+    let failures := diagnostics.push (obj [("severity", str "error"), ("message", str reason)])
+    return (1, envelope fixture status failures imports #[] #[] axioms false)
+  | .ok (declarations, state) =>
+    let result := envelope fixture "exported" diagnostics imports declarations state.nodes axioms true
+    if result.compress.toUTF8.size + 1 > maxOutputBytes then
+      let failures := diagnostics.push (obj [("severity", str "error"), ("message", str "serialized output bytes")])
+      return (1, envelope fixture "resource-limit" failures imports #[] #[] axioms false)
+    return (0, result)
+
+unsafe def runFixture (id : String) : IO (UInt32 × Json) := do
+  let some fixture := fixture? id
+    | return (64, obj [("schema", str "macsad-lean-command-error/1"), ("error", str "unknown trusted fixture")])
+  try exportSource fixture.source fixture.fileName fixture.target fixture.id catch error =>
+    let reason := toString error
+    let status := if reason.startsWith "resource-limit:" then "resource-limit" else "export-error"
+    let boundedReason := if reason.toUTF8.size ≤ 4096 then reason else "export failure detail exceeds byte budget"
+    return ((1 : UInt32), errorEnvelope fixture status boundedReason)
+
+end MaCSad.LeanExport
