index 0000000000000000000000000000000000000000..34a03f5d5959e34c0edf8b2d8664e7e2457087e8
--- /dev/null
+++ b/host_adapters/lean_bridge_evaluation.py
@@ -0,0 +1,237 @@
+"""Trusted-fixture evaluation ports, not an uploaded-Lean execution service.
+
+Lean source checking occurs in the separately recorded Windows fixture job.
+This port consumes its exact retained exports, projects facts losslessly to LOGOS,
+and executes a separately identified existing kernel checker. LOGOS owns every
+mathematical mapping and checker-result classification. No database is modified.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+import stat
+from pathlib import Path
+
+from host_adapters.lean_bridge_transport import (
+    core_arguments, decode_emission, export_fact_argument, _unique_object, _nonfinite,
+)
+from host_adapters.proof_process import run_bounded
+from host_adapters.proof_demo import write_new
+
+
+EXPORT_LIMIT = 262144
+LEAN_COMMIT = "68218e876d2a38b1985b8590fff244a83c321783"
+KERNEL_SHA256 = "56a4bc1fbb6b4a4495c67616c5f66d55929b0e78532145bbfb00ca5421353914"
+
+
+def _sha(payload):
+    return hashlib.sha256(payload).hexdigest()
+
+
+def _json(payload):
+    return json.loads(payload.decode("utf-8", errors="strict"),
+                      object_pairs_hook=_unique_object, parse_constant=_nonfinite)
+
+
+def _read(path, limit=EXPORT_LIMIT):
+    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
+        before = os.fstat(stream.fileno())
+        if not stat.S_ISREG(before.st_mode) or not 1 <= before.st_size <= limit:
+            raise ValueError("evidence is not a bounded nonempty regular file")
+        payload = stream.read(limit + 1)
+        after = os.fstat(stream.fileno())
+    if len(payload) > limit or (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
+        raise ValueError("evidence changed or exceeded its byte quota")
+    return payload
+
+
+def _binary_identity(path):
+    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), "rb") as stream:
+        before = os.fstat(stream.fileno())
+        if not stat.S_ISREG(before.st_mode) or before.st_size > 256 * 1024 * 1024:
+            raise ValueError("checker is not a regular file")
+        digest = hashlib.sha256()
+        for block in iter(lambda: stream.read(65536), b""):
+            digest.update(block)
+        after = os.fstat(stream.fileno())
+    if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
+        raise ValueError("checker changed while its identity was read")
+    return digest.hexdigest()
+
+
+def _observation(record):
+    return {"exit_code": record.exit_code, "termination": record.termination,
+            "stdout_hex": record.stdout.hex(), "stderr_hex": record.stderr.hex()}
+
+
+def _save_json(path, data):
+    write_new(path, (json.dumps(data, sort_keys=True, indent=2) + "\n").encode())
+
+
+def _environment(config):
+    return {"PATH": os.defpath, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8",
+            "LOGOS_WORKSPACE": config["logos_workspace"]}
+
+
+def _logos(config, arguments):
+    wrapper = Path(config["repository"]) / "scripts/logos.sh"
+    return run_bounded(["/bin/bash", str(wrapper), "run", "--interpret", "--seed", "7",
+                        "--max-steps", "1000000", "--timeout", "5s", "--", *arguments],
+                       cwd=Path(config["project"]), environment=_environment(config),
+                       timeout_seconds=15, output_limit=32768)
+
+
+def _projection(record):
+    """Raw Lean object-field projection; no target constructor choices."""
+    tags, left, right, indices, levels = [], [], [], [], []
+    for number, node in enumerate(record["nodes"], 1):
+        if type(node) is not dict or type(node.get("id")) is not int or node["id"] != number:
+            raise ValueError("core rows must retain exact consecutive source node IDs")
+        tag = node["tag"]
+        tags.append(tag)
+        first, second, index, level = 0, 0, "", ""
+        if tag in ("forallE", "lam"):
+            first, second = node["domain"], node["body"]
+        elif tag == "app":
+            first, second = node["function"], node["argument"]
+        elif tag == "bvar":
+            index = node["index"]
+        elif tag == "sort":
+            level = node["level"]["tag"]
+        left.append(first)
+        right.append(second)
+        indices.append(index)
+        levels.append(level)
+    return tags, left, right, indices, levels
+
+
+def _fixture(fixture, config):
+    expected = config["fixtures"][fixture]
+    name = expected["file"]
+    if type(name) is not str or re.fullmatch(r"[A-Za-z0-9_-]+\.json", name) is None:
+        raise ValueError("export file must be one contained fixture basename")
+    exports = Path(config["exports"])
+    if not exports.is_absolute() or exports.is_symlink() or exports.resolve(strict=True) != exports:
+        raise ValueError("fixture root must be an exact real directory without symlink ancestors")
+    payload = _read(exports / name)
+    if _sha(payload) != expected["export_sha256"]:
+        raise ValueError("export identity does not match the trusted fixture job")
+    record = _json(payload)
+    fields = {"schema", "exporterVersion", "compiler", "source", "status", "diagnostics", "targetName",
+              "imports", "declarations", "nodes", "axiomDependencies", "closureComplete"}
+    if type(record) is not dict or set(record) != fields:
+        raise ValueError("unexpected export envelope")
+    if record["schema"] != "macsad-lean-core/1" or record["exporterVersion"] != "1":
+        raise ValueError("unsupported export transport version")
+    if record["compiler"] != {"version": "4.31.0", "gitCommit": LEAN_COMMIT}:
+        raise ValueError("export compiler differs from the recorded Lean job")
+    for key in ["nodes", "declarations", "axiomDependencies", "diagnostics", "imports"]:
+        if type(record[key]) is not list:
+            raise ValueError("export array primitive type mismatch")
+    if type(record["closureComplete"]) is not bool:
+        raise ValueError("export closure fact must be Boolean")
+    source = record["source"]
+    if type(source) is not dict or source.get("fixtureId") != fixture or type(source.get("utf8Hex")) is not str:
+        raise ValueError("trusted source identity is missing")
+    raw_source = bytes.fromhex(source["utf8Hex"])
+    if raw_source.hex() != source["utf8Hex"] or len(raw_source) != source["byteLength"]:
+        raise ValueError("source bytes are not exact canonical transport")
+    raw_source.decode("utf-8", errors="strict")
+    if _sha(raw_source) != expected["source_sha256"] or record["targetName"] != expected["targetName"]:
+        raise ValueError("source or requested target differs from trusted fixture job")
+    declarations = record["declarations"]
+    target = {"kind": "absent", "typeRoot": 0, "valueRoot": None, "levelParams": []}
+    if declarations:
+        target = declarations[0]
+        required = {"name", "displayName", "kind", "levelParams", "typeRoot", "valueRoot", "details"}
+        if type(target) is not dict or set(target) != required or target["name"] != record["targetName"]:
+            raise ValueError("exact target declaration object is missing or mismatched")
+        if type(target["levelParams"]) is not list:
+            raise ValueError("universe parameter facts are not a list")
+    if record["status"] == "exported" and (not declarations or expected["lean_exit_code"] != 0):
+        raise ValueError("exported facts contradict recorded Lean execution")
+    proof = 0 if target["valueRoot"] is None else target["valueRoot"]
+    arguments = core_arguments(*_projection(record), proof, target["typeRoot"])
+    arguments.append(export_fact_argument(True, True, record["closureComplete"], record["status"], target["kind"],
+                                         len(record["axiomDependencies"]), len(target["levelParams"]), 10000))
+    return payload, raw_source, record, arguments
+
+
+def _kernel(config, certificate_path, destination, *, expected_certificate_sha256, target_matches):
+    checker = Path(config["checker"])
+    expected = config["checker_sha256"]
+    if expected != KERNEL_SHA256 or _binary_identity(checker) != expected:
+        raise ValueError("kernel executable is not the exact evaluated artifact")
+    before = _read(certificate_path, 32768)
+    result = run_bounded([str(checker), str(certificate_path)], cwd=destination,
+                         environment={"PATH": os.defpath, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"},
+                         timeout_seconds=15, output_limit=32768)
+    _save_json(destination / "kernel-observation.json", _observation(result))
+    flags = [result.termination == "exited", _binary_identity(checker) == expected,
+             _sha(before) == expected_certificate_sha256 and _read(certificate_path, 32768) == before,
+             target_matches]
+    arguments = ["macsad-lean-check-wire/1", ",".join("1" if v else "0" for v in flags),
+                 str(result.exit_code if result.exit_code is not None else 127),
+                 result.stdout.decode("utf-8", errors="strict"), result.stderr.decode("utf-8", errors="strict")]
+    classification = _logos(config, arguments)
+    _save_json(destination / "classification-observation.json", _observation(classification))
+    if classification.termination != "exited" or classification.exit_code != 0:
+        raise RuntimeError("LOGOS checker-report policy did not return normally")
+    report = _json(classification.stdout)
+    if set(report) != {"schema", "status"} or report["schema"] != "macsad-lean-check-result/1":
+        raise ValueError("LOGOS checker-report transport is malformed")
+    return {"status": report["status"], "kernel_exit_code": result.exit_code}
+
+
+def evaluate_fixture(fixture, config, destination):
+    """Run only a named, hash-bound export from our separately checked fixture job."""
+    payload, raw_source, record, arguments = _fixture(fixture, config)
+    # All fixture identity/shape validation precedes artifact creation or tools.
+    destination = Path(destination)
+    destination.mkdir(mode=0o700)
+    write_new(destination / "input.lean", raw_source)
+    write_new(destination / "lean-export.json", payload)
+    _save_json(destination / "raw-facts.json", arguments)
+    emitted = _logos(config, arguments)
+    _save_json(destination / "emission-observation.json", _observation(emitted))
+    if emitted.termination != "exited" or emitted.exit_code in (122, 124):
+        return {"status": "resource-limit", "checker_invoked": False}
+    if emitted.exit_code != 0:
+        raise RuntimeError("LOGOS translation invocation failed; no theorem verdict")
+    decoded = decode_emission(emitted.stdout)
+    summary = {"status": decoded["status"], "emission_status": decoded["status"], "checker_invoked": False,
+               "export_sha256": _sha(payload), "source_sha256": _sha(raw_source),
+               "source_target": record["targetName"], "axiom_dependencies": record["axiomDependencies"]}
+    if decoded["status"] == "emitted":
+        write_new(destination / "proof.term", decoded["proof"].encode())
+        write_new(destination / "type.term", decoded["type"].encode())
+        write_new(destination / "correspondence.txt", decoded["mapping"].encode())
+        write_new(destination / "certificate.json", decoded["certificate"])
+        # This is real kernel vernacular, not largo prove's English/Tarski syntax.
+        code = f"Definition translated_theorem : {decoded['type']} := {decoded['proof']}.\n"
+        write_new(destination / "translated.kernel.lg", code.encode())
+        summary.update(_kernel(config, destination / "certificate.json", destination,
+                               expected_certificate_sha256=_sha(decoded["certificate"]),
+                               target_matches=record["targetName"] == config["fixtures"][fixture]["targetName"]))
+        summary.update(checker_invoked=True, certificate_sha256=_sha(decoded["certificate"]),
+                       proof=decoded["proof"], type=decoded["type"])
+    _save_json(destination / "result.json", summary)
+    return summary
+
+
+def reject_altered_claim(config, original, destination):
+    """Deliberate negative control: preserve proof bytes but claim the type Prop."""
+    evaluate_fixture("identity", config, original)
+    original_bytes = _read(Path(original) / "certificate.json", 32768)
+    certificate = _json(original_bytes)
+    certificate["claimed_type"] = {"Sort": "Prop"}
+    destination = Path(destination)
+    destination.mkdir(mode=0o700)
+    _save_json(destination / "certificate.json", certificate)
+    result = _kernel(config, destination / "certificate.json", destination,
+                     expected_certificate_sha256=_sha(original_bytes), target_matches=False)
+    _save_json(destination / "result.json", result)
+    return result
