+++ b/tools/lean-bridge/Tests.lean
@@ -0,0 +1,86 @@
+import CoreExport
+
+open Lean MaCSad.LeanExport
+
+private def check (condition : Bool) (message : String) : IO Unit :=
+  unless condition do throw (IO.userError message)
+
+private def field (json : Json) (key : String) : IO Json :=
+  match json.getObjVal? key with
+  | .ok value => pure value
+  | .error reason => throw (IO.userError reason)
+
+private def arrayField (json : Json) (key : String) : IO (Array Json) := do
+  match (← field json key).getArr? with
+  | .ok value => pure value
+  | .error reason => throw (IO.userError reason)
+
+private def natField (json : Json) (key : String) : IO Nat := do
+  match (← field json key).getNat? with
+  | .ok value => pure value
+  | .error reason => throw (IO.userError reason)
+
+private def checkTargetDeclaration (id : String) (result : Json) : IO Unit := do
+  let some fixture := fixture? id | throw (IO.userError s!"unknown fixture: {id}")
+  let declarations ← arrayField result "declarations"
+  check (declarations.size == 1) s!"{id}: unexpected declaration closure"
+  let declaration := declarations[0]!
+  check ((← field declaration "name") == nameJson fixture.target) s!"{id}: exact declaration name missing"
+  check ((← field result "targetName") == nameJson fixture.target) s!"{id}: target mismatch"
+  check ((← field declaration "displayName") == str fixture.target.toString) s!"{id}: display name mismatch"
+  check ((← field declaration "kind") == str "theorem") s!"{id}: declaration is not a theorem object"
+  check ((← arrayField declaration "levelParams").isEmpty) s!"{id}: unexpected universe parameters"
+  let details ← field declaration "details"
+  check ((← arrayField details "all").all (· == nameJson fixture.target)) s!"{id}: unexpected mutual declaration"
+  let nodes ← arrayField result "nodes"
+  let typeRoot ← natField declaration "typeRoot"
+  let valueRoot ← natField declaration "valueRoot"
+  check (typeRoot > 0 && typeRoot ≤ nodes.size) s!"{id}: missing or invalid type root"
+  check (valueRoot > 0 && valueRoot ≤ nodes.size && valueRoot != typeRoot) s!"{id}: missing or invalid proof root"
+  let typeNode := nodes[typeRoot - 1]!
+  let valueNode := nodes[valueRoot - 1]!
+  check ((← natField typeNode "id") == typeRoot) s!"{id}: type root points at wrong node"
+  check ((← natField valueNode "id") == valueRoot) s!"{id}: value root points at wrong node"
+  check ((← field typeNode "tag") == str "forallE") s!"{id}: actual theorem type was not retained"
+  check ((← field valueNode "tag") == str "lam") s!"{id}: actual proof lambda was not retained"
+
+unsafe def main (arguments : List String) : IO UInt32 := do
+  let [id] := arguments | throw (IO.userError "run exactly one trusted regression per owned process")
+  if ["identity", "composition", "repeated_binders", "long_composition"].contains id then
+    let (code, result) ← runFixture id
+    check (code == 0) s!"{id}: exporter failed"
+    check ((← field result "status") == str "exported") s!"{id}: wrong status"
+    check ((← field result "closureComplete") == toJson true) s!"{id}: incomplete closure"
+    check ((← arrayField result "axiomDependencies").isEmpty) s!"{id}: unexpected axiom"
+    checkTargetDeclaration id result
+    check (!(← arrayField result "nodes").isEmpty) s!"{id}: empty core graph"
+    let (repeatCode, repeatResult) ← runFixture id
+    check (repeatCode == code && repeatResult.compress == result.compress) s!"{id}: nondeterministic export"
+  else if id == "invalid_proof" then
+    let (invalidCode, invalid) ← runFixture "invalid_proof"
+    check (invalidCode != 0) "invalid proof did not return a failure exit code"
+    check ((← field invalid "status") == str "elaboration-error") "invalid proof was not rejected by Lean"
+    check ((← arrayField invalid "nodes").isEmpty) "invalid elaboration exported a recovered proof as evidence"
+  -- The actual sorry closure exceeds the declared 32-declaration budget. This
+  -- is a retained resource failure, not invalid mathematics or acceptance.
+  else if id == "sorry" then
+    let (sorryCode, sorryResult) ← runFixture "sorry"
+    check (sorryCode == 1) "sorry: expected explicit quota failure"
+    check ((← field sorryResult "status") == str "resource-limit") "sorry: quota was misclassified"
+    check ((← field sorryResult "closureComplete") == toJson false) "sorry: incomplete closure claimed complete"
+    check ((← arrayField sorryResult "axiomDependencies").contains (nameJson `sorryAx)) "sorryAx fact was omitted"
+    check ((← arrayField sorryResult "nodes").isEmpty && (← arrayField sorryResult "declarations").isEmpty)
+      "sorry: partial closure exposed as usable evidence"
+  else if id == "axiom_dependency" then
+    let (axiomCode, axiomResult) ← runFixture "axiom_dependency"
+    check (axiomCode == 0) "custom axiom: facts must remain exportable, not silently repaired"
+    check ((← arrayField axiomResult "axiomDependencies").contains (nameJson `MaCSadFixture.unproven))
+      "custom axiom: actual dependency was omitted"
+    check ((← field axiomResult "status") == str "exported") "custom axiom: export is not acceptance"
+    check ((← field axiomResult "closureComplete") == toJson true) "custom axiom: incomplete closure"
+  else if id == "unknown_source" then
+    let (unknownCode, _) ← runFixture "untrusted-upload.lean"
+    check (unknownCode == 64) "an arbitrary source path was accepted"
+  else throw (IO.userError "unknown regression")
+  IO.println s!"Trusted Lean export check passed: {id}; no LOGOS acceptance is claimed."
+  return 0
