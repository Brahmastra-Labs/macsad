index 0000000000000000000000000000000000000000..f30971bf87b7a7dbe988bba9d00446239f2f5415
--- /dev/null
+++ b/host_adapters/lean_bridge_transport.py
@@ -0,0 +1,132 @@
+"""Bounded lossless fact framing. LOGOS, not this port, selects term mappings."""
+
+from __future__ import annotations
+
+import json
+import re
+
+
+MAX_WIRE_BYTES = 32768
+_TOKEN = re.compile(r"[A-Za-z][A-Za-z0-9_-]*\Z", re.ASCII)
+_NATURAL = re.compile(r"(?:0|[1-9][0-9]*)\Z", re.ASCII)
+_HEX = re.compile(r"(?:[0-9a-f]{2})*\Z", re.ASCII)
+
+
+class TransportLimit(ValueError):
+    """Explicit prototype transport quota, not mathematical invalidity."""
+
+
+def _sequence(value):
+    if type(value) is not list:
+        raise ValueError("fact sequences must be exact lists")
+    if len(value) > MAX_WIRE_BYTES:
+        raise TransportLimit("prototype fact sequence exceeds transport quota")
+    return value
+
+
+def _integer(value):
+    if type(value) is not int or not 0 <= value <= 2**63 - 1:
+        raise ValueError("node references must be exact nonnegative machine integers")
+    return str(value)
+
+
+def _text(value, pattern, *, empty=False):
+    if type(value) is not str:
+        raise ValueError("fact token must be exact text")
+    if len(value) > MAX_WIRE_BYTES:
+        raise TransportLimit("prototype fact token exceeds transport quota")
+    if not (empty and value == "") and pattern.fullmatch(value) is None:
+        raise ValueError("fact token is not canonical or contains a delimiter")
+    return value
+
+
+def _framed(values, encode):
+    tokens = []
+    size = 0
+    for value in _sequence(values):
+        token = encode(value)
+        size += len(token) + (1 if tokens else 0)
+        if size > MAX_WIRE_BYTES:
+            raise TransportLimit("prototype fact column exceeds transport quota")
+        tokens.append(token)
+    return ",".join(tokens)
+
+
+def core_arguments(tags, left, right, indices, levels, proof_root, claim_root):
+    """Project primitive facts only; preserve unsupported tags and exact Lean Nats.
+
+    No constructor is translated, no binder index is narrowed, and no term is
+    repaired here. LOGOS receives the original raw tags and selects the mapping.
+    Array-length, reference, scope and mathematical-support checks belong there.
+    """
+    result = [
+        "macsad-lean-core-wire/1",
+        _framed(tags, lambda v: _text(v, _TOKEN)),
+        _framed(left, _integer),
+        _framed(right, _integer),
+        _framed(indices, lambda v: _text(v, _NATURAL, empty=True)),
+        _framed(levels, lambda v: _text(v, _TOKEN, empty=True)),
+        _integer(proof_root), _integer(claim_root),
+    ]
+    if sum(len(v.encode("utf-8")) + 1 for v in result) > MAX_WIRE_BYTES:
+        raise TransportLimit("prototype argument wire exceeds transport quota")
+    return result
+
+
+def export_fact_argument(transport, source_identity, closure, status, kind, axioms, levels, quota):
+    flags = []
+    for flag in [transport, source_identity, closure]:
+        if type(flag) is not bool:
+            raise ValueError("source flags must be exact booleans")
+        flags.append("1" if flag else "0")
+    return ",".join(flags + [_text(status, _TOKEN), _text(kind, _TOKEN),
+                             _integer(axioms), _integer(levels), _integer(quota)])
+
+
+def _unique_object(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            raise ValueError("duplicate JSON key")
+        result[key] = value
+    return result
+
+
+def _nonfinite(_):
+    raise ValueError("nonfinite JSON value")
+
+
+def decode_emission(payload):
+    """Decode the exact output contract without deciding that a proof is valid."""
+    if type(payload) is not bytes or not payload:
+        raise ValueError("emission must be nonempty bytes")
+    if len(payload) > MAX_WIRE_BYTES:
+        raise TransportLimit("prototype output exceeds transport quota")
+    try:
+        record = json.loads(payload.decode("utf-8", errors="strict"),
+                            object_pairs_hook=_unique_object, parse_constant=_nonfinite)
+    except (ValueError, UnicodeError, RecursionError) as error:
+        raise ValueError("emission must be strict bounded JSON") from error
+    fields = {"schema", "status", "proof_hex", "type_hex", "certificate_hex", "mapping_hex"}
+    if type(record) is not dict or set(record) != fields:
+        raise ValueError("unexpected emission fields")
+    if record["schema"] != "macsad-lean-core-result/1":
+        raise ValueError("unexpected emission schema")
+    status = record["status"]
+    if type(status) is not str or status not in {"emitted", "invalid", "unsupported", "resource-limit"}:
+        raise ValueError("unexpected emission status")
+    decoded = {}
+    for source, destination in [("proof_hex", "proof"), ("type_hex", "type"),
+                                ("certificate_hex", "certificate"), ("mapping_hex", "mapping")]:
+        value = record[source]
+        if type(value) is not str or _HEX.fullmatch(value) is None:
+            raise ValueError("emission field must be canonical lowercase byte hex")
+        if (status == "emitted") != bool(value):
+            raise ValueError("emission field presence contradicts its status")
+        raw = bytes.fromhex(value)
+        try:
+            text = raw.decode("utf-8", errors="strict")
+        except UnicodeError as error:
+            raise ValueError("emission field is not UTF-8") from error
+        decoded[destination] = raw if destination == "certificate" else text
+    return {"status": status, **decoded}
