@@ -0,0 +1,82 @@
+"""RED contracts for mechanical transport, not mathematical acceptance."""
+
+import json
+import unittest
+
+from host_adapters.lean_bridge_transport import core_arguments, decode_emission, export_fact_argument
+
+
+class LeanBridgeTransportTests(unittest.TestCase):
+    def test_exact_raw_core_fact_projection(self):
+        self.assertEqual(
+            core_arguments(["sort", "bvar"], [0, 0], [0, 0], ["", "0"], ["zero", ""], 2, 1),
+            ["macsad-lean-core-wire/1", "sort,bvar", "0,0", "0,0", ",0", "zero,", "2", "1"],
+        )
+
+    def test_preserves_large_lean_natural_and_unsupported_tag(self):
+        # Host does not truncate Lean indices or decide mathematical support.
+        huge = "1234567890123456789012345678901234567890"
+        result = core_arguments(["bvar", "const"], [0, 0], [0, 0], [huge, ""], ["", ""], 1, 2)
+        self.assertEqual(result[1], "bvar,const")
+        self.assertEqual(result[4], huge + ",")
+
+    def test_wire_rejects_inexact_primitive_types_and_delimiter_injection(self):
+        valid = [["sort"], [0], [0], [""], ["zero"], 1, 1]
+        for position, value in [(0, ["sort,app"]), (0, ["sort\0"]), (1, [False]),
+                                (1, [1.0]), (3, [0]), (3, ["+0"]), (3, ["00"]),
+                                (4, ["zero,zero"]), (5, True), (6, 1.0)]:
+            args = list(valid)
+            args[position] = value
+            with self.subTest(position=position, value=value), self.assertRaises(ValueError):
+                core_arguments(*args)
+
+    def test_emission_decodes_exact_utf8_bytes_without_rewriting_code(self):
+        record = {"schema": "macsad-lean-core-result/1", "status": "emitted",
+                  "proof_hex": "(fun α => α)".encode().hex(),
+                  "type_hex": "Prop".encode().hex(), "certificate_hex": "7b7d", "mapping_hex": "317c736f7274"}
+        result = decode_emission((json.dumps(record) + "\n").encode())
+        self.assertEqual(result["proof"], "(fun α => α)")
+        self.assertEqual(result["type"], "Prop")
+        self.assertEqual(result["certificate"], b"{}")
+        self.assertEqual(result["mapping"], "1|sort")
+        self.assertEqual(result["status"], "emitted")
+
+    def test_keeps_unsuccessful_statuses_distinct(self):
+        for status in ["invalid", "unsupported", "resource-limit"]:
+            record = {"schema": "macsad-lean-core-result/1", "status": status,
+                      "proof_hex": "", "type_hex": "", "certificate_hex": "", "mapping_hex": ""}
+            self.assertEqual(decode_emission(json.dumps(record).encode())["status"], status)
+
+    def test_rejects_malformed_native_output_and_overflow(self):
+        record = {"schema": "macsad-lean-core-result/1", "status": "emitted",
+                  "proof_hex": "61", "type_hex": "62", "certificate_hex": "7b7d", "mapping_hex": "31"}
+        malformed = [b"", b"null", b"{}", b"x" * 32769]
+        for key, value in [("proof_hex", "ff"), ("proof_hex", "C3A9"),
+                           ("proof_hex", "0"), ("proof_hex", ""),
+                           ("certificate_hex", 12), ("status", "verified"),
+                           ("schema", "other"), ("surprise", True)]:
+            bad = dict(record)
+            bad[key] = value
+            malformed.append(json.dumps(bad).encode())
+        malformed.append(json.dumps(record).replace('"emitted"', '"emitted", "status":"emitted"').encode())
+        for payload in malformed:
+            with self.subTest(payload=payload[:100]), self.assertRaises(ValueError):
+                decode_emission(payload)
+
+    def test_source_facts_remain_facts_not_host_acceptance(self):
+        self.assertEqual(export_fact_argument(True, True, True, "exported", "theorem", 0, 0, 1024),
+                         "1,1,1,exported,theorem,0,0,1024")
+        self.assertEqual(export_fact_argument(True, False, False, "export-error", "axiom", 4, 2, 0),
+                         "1,0,0,export-error,axiom,4,2,0")
+        with self.assertRaises(ValueError):
+            export_fact_argument(1, True, True, "exported", "theorem", 0, 0, 1024)
+        with self.assertRaises(ValueError):
+            export_fact_argument(True, True, True, "exported,theorem", "theorem", 0, 0, 1024)
+
+    def test_transport_quota_does_not_silently_truncate(self):
+        with self.assertRaises(ValueError):
+            core_arguments(["sort"], [0], [0], ["1" * 32768, "2"], ["zero"], 1, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
