@@ -0,0 +1,81 @@
+"""Required real-tool prototype integration; absent prerequisites fail, never skip."""
+
+import json
+import os
+import tempfile
+import unittest
+from pathlib import Path
+
+from host_adapters.lean_bridge_evaluation import evaluate_fixture, reject_altered_claim, _binary_identity
+
+
+class RealLeanLogosBridgeTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.root = Path(os.environ["MACSAD_LEAN_BRIDGE_EVIDENCE"])
+        cls.config = json.loads((cls.root / "evaluation-config.json").read_text())
+
+    def test_identity_transfers_actual_lean_proof_and_checks_target(self):
+        result = evaluate_fixture("identity", self.config, self.root / "identity")
+        self.assertEqual(result["status"], "kernel-checked")
+        self.assertEqual(result["emission_status"], "emitted")
+        self.assertIn("forall", result["type"])
+        self.assertIn("fun", result["proof"])
+        self.assertNotEqual(result["certificate_sha256"], result["export_sha256"])
+
+    def test_composition_and_repeated_binders_transfer_without_capture(self):
+        for fixture in ["composition", "repeated_binders"]:
+            with self.subTest(fixture=fixture):
+                result = evaluate_fixture(fixture, self.config, self.root / fixture)
+                self.assertEqual(result["status"], "kernel-checked")
+                self.assertEqual(result["emission_status"], "emitted")
+
+    def test_missing_proof_and_custom_axiom_are_not_repaired(self):
+        for fixture, expected in [("sorry", "resource-limit"), ("axiom_dependency", "unsupported")]:
+            with self.subTest(fixture=fixture):
+                result = evaluate_fixture(fixture, self.config, self.root / fixture)
+                self.assertEqual(result["status"], expected)
+                self.assertFalse(result["checker_invoked"])
+
+    def test_invalid_original_proof_never_reaches_target_checker(self):
+        result = evaluate_fixture("invalid_proof", self.config, self.root / "invalid_proof")
+        self.assertEqual(result["status"], "invalid")
+        self.assertFalse(result["checker_invoked"])
+
+    def test_kernel_rejects_changed_target_for_same_translated_proof(self):
+        result = reject_altered_claim(self.config, self.root / "wrong-claim-source", self.root / "altered-claim")
+        self.assertEqual(result["kernel_exit_code"], 1)
+        self.assertEqual(result["status"], "rejected")
+
+    def test_unmatched_export_identity_rejected_before_artifact_effects(self):
+        config = json.loads(json.dumps(self.config))
+        config["fixtures"]["identity"]["export_sha256"] = "0" * 64
+        destination = self.root / "tampered-export"
+        with self.assertRaises(ValueError):
+            evaluate_fixture("identity", config, destination)
+        self.assertFalse(destination.exists())
+
+    def test_valid_longer_lean_proof_reports_current_job_quota_honestly(self):
+        result = evaluate_fixture("long_composition", self.config, self.root / "long_composition")
+        self.assertEqual(result["status"], "resource-limit")
+        self.assertFalse(result["checker_invoked"])
+
+    def test_export_path_escape_is_rejected_before_reading_or_effects(self):
+        config = json.loads(json.dumps(self.config))
+        config["fixtures"]["identity"]["file"] = "../identity-04.json"
+        destination = self.root / "escaped-export"
+        with self.assertRaises(ValueError):
+            evaluate_fixture("identity", config, destination)
+        self.assertFalse(destination.exists())
+
+    def test_checker_fifo_is_rejected_without_blocking(self):
+        # The harness is POSIX-only and owns this temporary directory and FIFO.
+        with tempfile.TemporaryDirectory(prefix="checker-fifo-", dir=self.root) as temporary:
+            fifo = Path(temporary) / "not-a-checker"
+            os.mkfifo(fifo)
+            with self.assertRaises(ValueError):
+                _binary_identity(fifo)
+
+
+if __name__ == "__main__":
+    unittest.main()
