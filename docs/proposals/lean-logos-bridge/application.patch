diff --git a/logos/lean-bridge/src/lean_bridge_driver.lg b/logos/lean-bridge/src/lean_bridge_driver.lg
new file mode 100644
index 0000000000000000000000000000000000000000..57a76d6bd0906b0a97e1af0a7e0dccf895851958
--- /dev/null
+++ b/logos/lean-bridge/src/lean_bridge_driver.lg
@@ -0,0 +1,58 @@
+# MaCSad Lean bridge stateless driver
+
+Import LeanCoreTerms from "./lean_core_terms.lg".
+Import LeanCoreBudget from "./lean_core_budget.lg".
+Import LeanCoreCertificate from "./lean_core_certificate.lg".
+Import LeanExportStatus from "./lean_export_status.lg".
+Import LeanCheckStatus from "./lean_check_status.lg".
+Import LeanWire from "./lean_wire.lg".
+Import LeanBridgeInput from "./lean_bridge_input.lg".
+Import LeanCheckDriver from "./lean_check_driver.lg".
+
+## To leanCoreResult (status: Text, proof: Text, claim: Text, certificate: Text, mapping: Text) -> Text:
+    Let proofHex be toHex(proof).
+    Let claimHex be toHex(claim).
+    Let certificateHex be toHex(certificate).
+    Let mappingHex be toHex(mapping).
+    Let prefix be "{{\"schema\":\"macsad-lean-core-result/1\",\"status\":\"{status}\",".
+    Let fields be "\"proof_hex\":\"{proofHex}\",\"type_hex\":\"{claimHex}\",\"certificate_hex\":\"{certificateHex}\",\"mapping_hex\":\"{mappingHex}\"}}".
+    Return "{prefix}{fields}".
+
+## To leanBridgeMain (arguments: Seq of Text) -> Text:
+    If length of arguments is greater than 1:
+        If item 2 of arguments is equal to "macsad-lean-check-wire/1":
+            Return leanCheckWire(arguments).
+    If (length of arguments is equal to 10) is equal to false:
+        Return leanCoreResult("invalid", "", "", "", "").
+    Let mutable bytes be 0.
+    Repeat for position from 2 to 10:
+        Set bytes to bytes + length of text_bytes(item position of arguments).
+    If bytes is greater than 32768:
+        Return leanCoreResult("resource-limit", "", "", "", "").
+    If (item 2 of arguments is equal to "macsad-lean-core-wire/1") is equal to false:
+        Return leanCoreResult("invalid", "", "", "", "").
+    Let tags be split(item 3 of arguments, ",").
+    Let left be leanWireRefs(item 4 of arguments).
+    Let right be leanWireRefs(item 5 of arguments).
+    Let indices be split(item 6 of arguments, ",").
+    Let levels be split(item 7 of arguments, ",").
+    Let proofRoot be leanWireDecimal(item 8 of arguments).
+    Let claimRoot be leanWireDecimal(item 9 of arguments).
+    Let facts be split(item 10 of arguments, ",").
+    Let status be leanInputStatus(tags, left, right, indices, levels, proofRoot, claimRoot, facts).
+    If (status is equal to "eligible") is equal to false:
+        Return leanCoreResult(status, "", "", "", "").
+    Let proofJson be leanCoreTermJson(tags, left, right, indices, levels, proofRoot).
+    Let claimJson be leanCoreTermJson(tags, left, right, indices, levels, claimRoot).
+    If proofJson is equal to "" or claimJson is equal to "":
+        Return leanCoreResult("invalid", "", "", "", "").
+    Let certificate be leanCertificateJson(proofJson, claimJson).
+    Let proofText be leanCoreText(tags, left, right, indices, levels, proofRoot).
+    Let claimText be leanCoreText(tags, left, right, indices, levels, claimRoot).
+    Let mapping be leanCoreCorrespondence(tags).
+    If certificate is equal to "" or proofText is equal to "" or claimText is equal to "" or mapping is equal to "":
+        Return leanCoreResult("invalid", "", "", "", "").
+    Let result be leanCoreResult("emitted", proofText, claimText, certificate, mapping).
+    If length of text_bytes(result) is greater than 32768:
+        Return leanCoreResult("resource-limit", "", "", "", "").
+    Return result.
diff --git a/logos/lean-bridge/src/lean_bridge_input.lg b/logos/lean-bridge/src/lean_bridge_input.lg
new file mode 100644
index 0000000000000000000000000000000000000000..ff08a6d2a8d14e95ca1bb73dd448c1871497c4b8
--- /dev/null
+++ b/logos/lean-bridge/src/lean_bridge_input.lg
@@ -0,0 +1,29 @@
+# MaCSad Lean bridge input admission
+
+Import LeanCoreBudget from "./lean_core_budget.lg".
+Import LeanExportStatus from "./lean_export_status.lg".
+Import LeanWire from "./lean_wire.lg".
+
+## To leanInputStatus (tags: Seq of Text, left: Seq of Int, right: Seq of Int, indices: Seq of Text, levels: Seq of Text, proof: Int, claim: Int, facts: Seq of Text) -> Text:
+    If (length of facts is equal to 8) is equal to false:
+        Return "invalid".
+    Repeat for position from 1 to 3:
+        Let bit be item position of facts.
+        If (bit is equal to "0" or bit is equal to "1") is equal to false:
+            Return "invalid".
+    Let transport be item 1 of facts is equal to "1".
+    Let source be item 2 of facts is equal to "1".
+    Let complete be item 3 of facts is equal to "1".
+    Let axioms be leanWireDecimal(item 6 of facts).
+    Let parameters be leanWireDecimal(item 7 of facts).
+    Let status be leanExportStatus(transport, source, complete, item 4 of facts, item 5 of facts, axioms, parameters).
+    If (status is equal to "eligible") is equal to false:
+        Return status.
+    Let quota be leanWireDecimal(item 8 of facts).
+    Let budget be leanCoreBudgetStatus(tags, left, right, proof, claim, quota).
+    If (budget is equal to "within-budget") is equal to false:
+        Return budget.
+    Let fields be leanCoreFieldStatus(tags, indices, levels).
+    If (fields is equal to "fields-valid") is equal to false:
+        Return fields.
+    Return "eligible".
diff --git a/logos/lean-bridge/src/lean_check_driver.lg b/logos/lean-bridge/src/lean_check_driver.lg
new file mode 100644
index 0000000000000000000000000000000000000000..d4ad612839f7e7ef63c15e936454258fedf6ccf6
--- /dev/null
