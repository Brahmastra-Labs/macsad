@@ -0,0 +1,29 @@
+# MaCSad checker-facts wire driver
+
+Import LeanCheckStatus from "./lean_check_status.lg".
+Import LeanWire from "./lean_wire.lg".
+
+## To leanCheckResult (status: Text) -> Text:
+    Return "{{\"schema\":\"macsad-lean-check-result/1\",\"status\":\"{status}\"}}".
+
+## To leanCheckWire (arguments: Seq of Text) -> Text:
+    If (length of arguments is equal to 6) is equal to false:
+        Return leanCheckResult("rejected").
+    Let mutable bytes be 0.
+    Repeat for position from 2 to 6:
+        Set bytes to bytes + length of text_bytes(item position of arguments).
+    If bytes is greater than 32768:
+        Return leanCheckResult("rejected").
+    Let flags be split(item 3 of arguments, ",").
+    If (length of flags is equal to 4) is equal to false:
+        Return leanCheckResult("rejected").
+    Repeat for bit in flags:
+        If (bit is equal to "0" or bit is equal to "1") is equal to false:
+            Return leanCheckResult("rejected").
+    Let transport be item 1 of flags is equal to "1".
+    Let checker be item 2 of flags is equal to "1".
+    Let certificate be item 3 of flags is equal to "1".
+    Let target be item 4 of flags is equal to "1".
+    Let code be leanWireDecimal(item 4 of arguments).
+    Let status be leanBridgeCheckStatus(transport, checker, certificate, target, code, item 5 of arguments, item 6 of arguments).
+    Return leanCheckResult(status).
diff --git a/logos/lean-bridge/src/lean_check_status.lg b/logos/lean-bridge/src/lean_check_status.lg
new file mode 100644
index 0000000000000000000000000000000000000000..5aa5ee11c8b91083c005ae151fd959513668a0bb
--- /dev/null
+++ b/logos/lean-bridge/src/lean_check_status.lg
@@ -0,0 +1,32 @@
+# MaCSad Lean bridge checker-result policy
+
+Only native LOGOS may classify the supplied mechanical process and identity facts.
+Kernel checked never means independently checked or universally translated.
+
+## To leanBridgeCheckStatus (transport: Bool, checker: Bool, certificate: Bool, target: Bool, code: Int, output: Text, error: Text) -> Text:
+    If transport is equal to false or checker is equal to false or certificate is equal to false or target is equal to false:
+        Return "rejected".
+    If code is equal to 0 and output is equal to "VERIFIED\n" and error is equal to "":
+        Return "kernel-checked".
+    If code is equal to 1 and output is equal to "" and length of text_bytes(error) is greater than 0:
+        Return "not-kernel-checked".
+    Return "rejected".
+
+## Test: Lean bridge checker requires exact successful process output
+    Expect that leanBridgeCheckStatus(true, true, true, true, 0, "VERIFIED\n", "") is equal to "kernel-checked".
+    Expect that leanBridgeCheckStatus(true, true, true, true, 0, "VERIFIED", "") is equal to "rejected".
+    Expect that leanBridgeCheckStatus(true, true, true, true, 0, "VERIFIED\nextra", "") is equal to "rejected".
+    Expect that leanBridgeCheckStatus(true, true, true, true, 0, "VERIFIED\n", "warning") is equal to "rejected".
+
+## Test: Lean bridge checker rejects mismatched evidence identities
+    Expect that leanBridgeCheckStatus(false, true, true, true, 0, "VERIFIED\n", "") is equal to "rejected".
+    Expect that leanBridgeCheckStatus(true, false, true, true, 0, "VERIFIED\n", "") is equal to "rejected".
+    Expect that leanBridgeCheckStatus(true, true, false, true, 0, "VERIFIED\n", "") is equal to "rejected".
+    Expect that leanBridgeCheckStatus(true, true, true, false, 0, "VERIFIED\n", "") is equal to "rejected".
+
+## Test: Lean bridge checker never upgrades failure or resource exhaustion
+    Expect that leanBridgeCheckStatus(true, true, true, true, 1, "", "REJECTED: wrong target\n") is equal to "not-kernel-checked".
+    Expect that leanBridgeCheckStatus(true, true, true, true, 124, "", "timeout") is equal to "rejected".
+    Expect that leanBridgeCheckStatus(true, true, true, true, 1, "VERIFIED\n", "") is equal to "rejected".
+    For all booleans identity:
+        Expect that leanBridgeCheckStatus(true, identity, true, true, 124, "VERIFIED\n", "") is equal to "rejected".
diff --git a/logos/lean-bridge/src/lean_core_budget.lg b/logos/lean-bridge/src/lean_core_budget.lg
new file mode 100644
index 0000000000000000000000000000000000000000..4faee68d83cf9b29976d11919b9847d1ecce1c1b
--- /dev/null
+++ b/logos/lean-bridge/src/lean_core_budget.lg
@@ -0,0 +1,114 @@
+# MaCSad Lean core expansion preflight
+
+Costs saturate before mathematical expansion. The driver calls this first.
+
+## To leanCoreBudgetStatus (tags: Seq of Text, left: Seq of Int, right: Seq of Int, proofRoot: Int, claimRoot: Int, quota: Int) -> Text:
+    Let count be length of tags.
+    If quota is less than 1 or quota is greater than 1000000:
+        Return "invalid".
+    If count is greater than 128:
+        Return "resource-limit".
+    If count is less than 1 or proofRoot is less than 1 or claimRoot is less than 1 or proofRoot is greater than count or claimRoot is greater than count:
+        Return "invalid".
+    If (length of left is equal to count) is equal to false or (length of right is equal to count) is equal to false:
+        Return "invalid".
+    Let costs be a new Seq of Int.
+    Let sizes be a new Seq of Int.
+    Repeat for position from 1 to count:
+        Let tag be item position of tags.
+        Let first be item position of left.
+        Let second be item position of right.
+        Let mutable cost be 1.
+        Let mutable size be 32.
+        If tag is equal to "sort" or tag is equal to "bvar":
+            If (first is equal to 0 and second is equal to 0) is equal to false:
+                Return "invalid".
+        Otherwise:
+            If (tag is equal to "forallE" or tag is equal to "lam" or tag is equal to "app") is equal to false:
+                Return "unsupported".
+            If first is less than 1 or second is less than 1 or first is at least position or second is at least position:
+                Return "invalid".
+            Set cost to 1 + item first of costs + item second of costs.
+            Set size to 128 + item first of sizes + item second of sizes.
+        If cost is greater than quota:
+            Set cost to quota + 1.
+        If size is greater than 65408:
+            Set size to 65409.
+        Push cost to costs.
+        Push size to sizes.
+    Let totalCost be item proofRoot of costs + item claimRoot of costs.
+    Let totalSize be item proofRoot of sizes + item claimRoot of sizes.
+    If totalCost is greater than quota or totalSize is greater than 65408:
+        Return "resource-limit".
+    Return "within-budget".
+
+## To leanCoreFieldStatus (tags: Seq of Text, indices: Seq of Text, levels: Seq of Text) -> Text:
+    Let count be length of tags.
+    If (length of indices is equal to count) is equal to false or (length of levels is equal to count) is equal to false:
+        Return "invalid".
+    Repeat for position from 1 to count:
+        Let tag be item position of tags.
+        Let index be item position of indices.
+        Let level be item position of levels.
+        If tag is equal to "sort":
+            If level is equal to "":
+                Return "invalid".
+            If (level is equal to "zero") is equal to false:
+                Return "unsupported".
+        Otherwise:
+            If (level is equal to "") is equal to false:
+                Return "invalid".
+        If tag is equal to "bvar":
+            If allDigits(index) is equal to false or length of text_bytes(index) is less than 1:
+                Return "invalid".
+            Let bytes be text_bytes(index).
+            If length of bytes is greater than 1:
+                If item 1 of bytes is equal to 48:
+                    Return "invalid".
+        Otherwise:
+            If (index is equal to "") is equal to false:
+                Return "invalid".
+    Return "fields-valid".
+
+## Test: Lean core preflight saturates a doubling DAG
+    Let tags be ["sort"].
+    Let left be [0].
+    Let right be [0].
+    Repeat for position from 2 to 128:
+        Push "app" to tags.
+        Let previous be position - 1.
+        Push previous to left.
+        Push previous to right.
+    Expect that leanCoreBudgetStatus(tags, left, right, 128, 128, 4096) is equal to "resource-limit".
+
+## Test: Lean core preflight accounts for both roots at the quota boundary
+    Expect that leanCoreBudgetStatus(["sort"], [0], [0], 1, 1, 2) is equal to "within-budget".
+    Expect that leanCoreBudgetStatus(["sort"], [0], [0], 1, 1, 1) is equal to "resource-limit".
+    Expect that leanCoreBudgetStatus(["sort"], [0], [0], 1, 1, 0) is equal to "invalid".
+    Expect that leanCoreBudgetStatus(["sort"], [0], [0], 1, 1, 1000001) is equal to "invalid".
+
+## Test: Lean core preflight rejects malformed references before indexing
+    Expect that leanCoreBudgetStatus(["app"], [1], [1], 1, 1, 4096) is equal to "invalid".
+    Expect that leanCoreBudgetStatus(["sort", "app"], [0, 3], [0, 1], 2, 2, 4096) is equal to "invalid".
+    Expect that leanCoreBudgetStatus(["sort"], [0, 0], [0], 1, 1, 4096) is equal to "invalid".
+    Expect that leanCoreBudgetStatus(["sort"], [0], [0], 0, 1, 4096) is equal to "invalid".
+
+## Test: Lean core preflight preserves unsupported status
+    Expect that leanCoreBudgetStatus(["const"], [0], [0], 1, 1, 4096) is equal to "unsupported".
+    For all booleans useMeta:
+        Let mutable tag be "const".
+        If useMeta:
+            Set tag to "mvar".
+        Expect that leanCoreBudgetStatus([tag], [0], [0], 1, 1, 4096) is equal to "unsupported".
+
+## Test: Lean core scalar fields preserve exact indices and level support
+    Expect that leanCoreFieldStatus(["sort", "bvar"], ["", "12345678901234567890"], ["zero", ""]) is equal to "fields-valid".
+    Expect that leanCoreFieldStatus(["bvar"], ["01"], [""]) is equal to "invalid".
+    Expect that leanCoreFieldStatus(["sort"], [""], ["succ"]) is equal to "unsupported".
+    Expect that leanCoreFieldStatus(["sort"], [""], [""]) is equal to "invalid".
+    Expect that leanCoreFieldStatus(["sort"], [""], ["zero", ""]) is equal to "invalid".
+
+## Test: Lean core scalar fields reject hidden unused payload
+    Expect that leanCoreFieldStatus(["sort"], ["0"], ["zero"]) is equal to "invalid".
+    Expect that leanCoreFieldStatus(["lam"], ["1"], [""]) is equal to "invalid".
+    Expect that leanCoreFieldStatus(["bvar"], ["0"], ["zero"]) is equal to "invalid".
diff --git a/logos/lean-bridge/src/lean_core_certificate.lg b/logos/lean-bridge/src/lean_core_certificate.lg
new file mode 100644
index 0000000000000000000000000000000000000000..73c27ed9e18017d5e7f389e2b39c8bd1dc9862a8
--- /dev/null
+++ b/logos/lean-bridge/src/lean_core_certificate.lg
@@ -0,0 +1,35 @@
+# MaCSad mapped-term certificate assembly
+
+This formatter receives only mapped target terms from the private LOGOS caller.
+It neither parses arbitrary JSON nor decides whether the terms prove a theorem.
+
+## To leanCertificateJson (proof: Text, claim: Text) -> Text:
+    If proof is equal to "" or claim is equal to "":
+        Return "".
+    Let bytes be length of text_bytes(proof) + length of text_bytes(claim).
+    If bytes is greater than 65408:
+        Return "".
+    Return "{{\"proof_term\":{proof},\"claimed_type\":{claim},\"prelude_version\":\"logos-coc-1\"}}".
+
+## Test: Lean certificate assembly binds proof and claim without repair
+    Let proof be "{{\"Var\":\"b0\"}}".
+    Let claim be "{{\"Sort\":\"Prop\"}}".
+    Let expected be "{{\"proof_term\":{proof},\"claimed_type\":{claim},\"prelude_version\":\"logos-coc-1\"}}".
+    Expect that leanCertificateJson(proof, claim) is equal to expected.
+    Let reversed be "{{\"proof_term\":{claim},\"claimed_type\":{proof},\"prelude_version\":\"logos-coc-1\"}}".
+    Expect that leanCertificateJson(claim, proof) is equal to reversed.
+
+## Test: Lean certificate assembly refuses absent mapped terms
+    Expect that leanCertificateJson("", "{{\"Sort\":\"Prop\"}}") is equal to "".
+    Expect that leanCertificateJson("{{\"Sort\":\"Prop\"}}", "") is equal to "".
+    For all booleans missingProof:
+        Let mutable proof be "{{\"Sort\":\"Prop\"}}".
+        Let mutable claim be "".
+        If missingProof:
+            Set proof to "".
+            Set claim to "{{\"Sort\":\"Prop\"}}".
+        Expect that leanCertificateJson(proof, claim) is equal to "".
+
+## Test: Lean certificate assembly bounds combined payload bytes
+    Let huge be repeatText("x", 65409).
+    Expect that leanCertificateJson(huge, "x") is equal to "".
diff --git a/logos/lean-bridge/src/lean_core_terms.lg b/logos/lean-bridge/src/lean_core_terms.lg
new file mode 100644
index 0000000000000000000000000000000000000000..14cc60c8fd1b993c08e189d82a3fa69cffcfcc2f
--- /dev/null
+++ b/logos/lean-bridge/src/lean_core_terms.lg
@@ -0,0 +1,120 @@
+# MaCSad Lean core-term mapping and canonical emission
+
+## To leanCoreText (tags: Seq of Text, left: Seq of Int, right: Seq of Int, indices: Seq of Text, levels: Seq of Text, root: Int) -> Text:
+    Return coreTermEmit(tags, left, right, indices, levels, root, 0, false).
+
+## To leanCoreTermJson (tags: Seq of Text, left: Seq of Int, right: Seq of Int, indices: Seq of Text, levels: Seq of Text, root: Int) -> Text:
+    Return coreTermEmit(tags, left, right, indices, levels, root, 0, true).
+
+## To coreTermEmit (tags: Seq of Text, left: Seq of Int, right: Seq of Int, indices: Seq of Text, levels: Seq of Text, root: Int, depth: Int, json: Bool) -> Text:
+    Let count be length of tags.
+    If count is less than 1 or count is greater than 128 or root is less than 1 or root is greater than count:
+        Return "".
+    If (length of left is equal to count) is equal to false or (length of right is equal to count) is equal to false:
+        Return "".
+    If (length of indices is equal to count) is equal to false or (length of levels is equal to count) is equal to false:
+        Return "".
+    Let tag be item root of tags.
+    Let first be item root of left.
+    Let second be item root of right.
+    Let index be item root of indices.
+    Let level be item root of levels.
+    If tag is equal to "sort":
+        If first is equal to 0 and second is equal to 0 and index is equal to "" and level is equal to "zero":
+            If json:
+                Return "{{\"Sort\":\"Prop\"}}".
+            Return "Prop".
+        Return "".
+    If tag is equal to "bvar":
+        If (first is equal to 0) is equal to false or (second is equal to 0) is equal to false or (level is equal to "") is equal to false or depth is less than 1:
+            Return "".
+        Let last be depth - 1.
+        Repeat for distance from 0 to last:
+            If index is equal to numText(distance):
+                Let position be depth - distance - 1.
+                If json:
+                    Return "{{\"Var\":\"b{position}\"}}".
+                Return "b{position}".
+        Return "".
+    If (tag is equal to "forallE" or tag is equal to "lam" or tag is equal to "app") is equal to false:
+        Return "".
+    If (index is equal to "" and level is equal to "") is equal to false or first is less than 1 or second is less than 1 or first is at least root or second is at least root:
+        Return "".
+    Let domain be coreTermEmit(tags, left, right, indices, levels, first, depth, json).
+    If domain is equal to "":
+        Return "".
+    Let mutable nested be depth.
+    If (tag is equal to "app") is equal to false:
+        Set nested to depth + 1.
+    Let body be coreTermEmit(tags, left, right, indices, levels, second, nested, json).
+    If domain is equal to "" or body is equal to "":
+        Return "".
+    If length of text_bytes(domain) + length of text_bytes(body) is greater than 65500:
+        Return "".
+    If json:
+        If tag is equal to "app":
+            Return "{{\"App\":[{domain},{body}]}}".
+        If tag is equal to "forallE":
+            Return "{{\"Pi\":{{\"param\":\"b{depth}\",\"param_type\":{domain},\"body_type\":{body}}}}}".
+        Return "{{\"Lambda\":{{\"param\":\"b{depth}\",\"param_type\":{domain},\"body\":{body}}}}}".
+    If tag is equal to "app":
+        Return "({domain} {body})".
+    If tag is equal to "forallE":
+        Return "(forall b{depth} : {domain}, {body})".
+    Return "(fun b{depth} : {domain} => {body})".
+
+## Test: Lean core emits the proposition identity statement and proof
+    Let tags be ["sort", "bvar", "bvar", "forallE", "forallE", "lam", "lam"].
+    Let left be [0, 0, 0, 2, 1, 2, 1].
+    Let right be [0, 0, 0, 3, 4, 2, 6].
+    Let indices be ["", "0", "1", "", "", "", ""].
+    Let levels be ["zero", "", "", "", "", "", ""].
+    Expect that leanCoreText(tags, left, right, indices, levels, 5) is equal to "(forall b0 : Prop, (forall b1 : b0, b0))".
+    Expect that leanCoreText(tags, left, right, indices, levels, 7) is equal to "(fun b0 : Prop => (fun b1 : b0 => b1))".
+    Let innerClaim be "{{\"Pi\":{{\"param\":\"b1\",\"param_type\":{{\"Var\":\"b0\"}},\"body_type\":{{\"Var\":\"b0\"}}}}}}".
+    Let claim be "{{\"Pi\":{{\"param\":\"b0\",\"param_type\":{{\"Sort\":\"Prop\"}},\"body_type\":{innerClaim}}}}}".
+    Let innerProof be "{{\"Lambda\":{{\"param\":\"b1\",\"param_type\":{{\"Var\":\"b0\"}},\"body\":{{\"Var\":\"b1\"}}}}}}".
+    Let proof be "{{\"Lambda\":{{\"param\":\"b0\",\"param_type\":{{\"Sort\":\"Prop\"}},\"body\":{innerProof}}}}}".
+    Expect that leanCoreTermJson(tags, left, right, indices, levels, 5) is equal to claim.
+    Expect that leanCoreTermJson(tags, left, right, indices, levels, 7) is equal to proof.
+
+## Test: Lean core preserves binder order and distant references
+    Let tags be ["sort", "bvar", "bvar", "bvar", "forallE", "forallE", "forallE", "lam", "lam", "lam"].
+    Let left be [0, 0, 0, 0, 3, 1, 1, 3, 1, 1].
+    Let right be [0, 0, 0, 0, 4, 5, 6, 2, 8, 9].
+    Let indices be ["", "0", "1", "2", "", "", "", "", "", ""].
+    Let levels be ["zero", "", "", "", "", "", "", "", "", ""].
+    Let statement be "(forall b0 : Prop, (forall b1 : Prop, (forall b2 : b0, b0)))".
+    Let proof be "(fun b0 : Prop => (fun b1 : Prop => (fun b2 : b0 => b2)))".
+    Expect that leanCoreText(tags, left, right, indices, levels, 7) is equal to statement.
+    Expect that leanCoreText(tags, left, right, indices, levels, 10) is equal to proof.
+
+## Test: Lean core keeps application operand order
+    Let tags be ["sort", "bvar", "bvar", "forallE", "app", "lam", "lam", "lam"].
+    Let left be [0, 0, 0, 2, 3, 3, 4, 1].
+    Let right be [0, 0, 0, 3, 2, 5, 6, 7].
+    Let indices be ["", "0", "1", "", "", "", "", ""].
+    Let levels be ["zero", "", "", "", "", "", "", ""].
+    Let proof be "(fun b0 : Prop => (fun b1 : (forall b1 : b0, b0) => (fun b2 : b0 => (b1 b2))))".
+    Expect that leanCoreText(tags, left, right, indices, levels, 8) is equal to proof.
+
+## Test: Lean core rejects malformed graph references and open variables
+    Expect that leanCoreText(["bvar"], [0], [0], ["0"], [""], 1) is equal to "".
+    Expect that leanCoreText(["bvar"], [0], [0], ["-1"], [""], 1) is equal to "".
+    Expect that leanCoreText(["sort"], [0], [0], [""], ["zero"], 0) is equal to "".
+    Expect that leanCoreText(["sort"], [0], [0], [""], ["zero"], 2) is equal to "".
+    Expect that leanCoreText(["sort"], [0, 0], [0], [""], ["zero"], 1) is equal to "".
+    Expect that leanCoreText(["sort", "forallE"], [0, 1], [0, 2], ["", ""], ["zero", ""], 2) is equal to "".
+    Expect that leanCoreText(["sort", "forallE"], [0, 3], [0, 1], ["", ""], ["zero", ""], 2) is equal to "".
+    Expect that leanCoreText(["sort"], [1], [0], [""], ["zero"], 1) is equal to "".
+
+## Test: Lean core never replaces unsupported assumptions or terms
+    Let unsupported be ["sorryAx", "axiom", "const", "lit", "mvar", "fvar", "letE", "proj", "mdata", "unknown"].
+    Repeat for tag in unsupported:
+        Expect that leanCoreText([tag], [0], [0], [""], [""], 1) is equal to "".
+    Expect that leanCoreText(["sort"], [0], [0], [""], ["succ"], 1) is equal to "".
+    For all booleans useHole:
+        Let mutable tag be "sorryAx".
+        If useHole:
+            Set tag to "mvar".
+        Expect that leanCoreText([tag], [0], [0], [""], [""], 1) is equal to "".
