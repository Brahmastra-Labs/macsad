+-- Read-only fingerprint for the bounded synthetic representative fixture.
+-- Includes every base-table row, count, version, event and audit-stream head.
+\set ON_ERROR_STOP on
+BEGIN ISOLATION LEVEL REPEATABLE READ READ ONLY;
+SET LOCAL ROLE macsad_owner;
+SET LOCAL search_path = pg_catalog;
+SET LOCAL timezone = 'UTC';
+SELECT format(
+  'SELECT %L, count(*), encode(sha256(convert_to(COALESCE(string_agg(to_jsonb(t)::text, E''\n'' ORDER BY to_jsonb(t)::text), ''''), ''UTF8'')), ''hex'') FROM %I.%I AS t;',
+  namespace.nspname || '.' || relation.relname,
+  namespace.nspname, relation.relname
+)
+FROM pg_class AS relation
+JOIN pg_namespace AS namespace ON namespace.oid = relation.relnamespace
+WHERE namespace.nspname IN ('macsad', 'macsad_meta')
+  AND relation.relkind IN ('r', 'p')
+ORDER BY namespace.nspname, relation.relname
+\gexec
+COMMIT;
