diff --git a/logos/gateway/target/board-read-contract/src/board_result_shape.lg b/logos/gateway/target/board-read-contract/src/board_result_shape.lg
new file mode 100644
--- /dev/null
+++ b/logos/gateway/target/board-read-contract/src/board_result_shape.lg
@@ -0,0 +1,102 @@
+# MaCSad board PostgreSQL result shape
+
+This import-free leaf validates a bounded nine-text-column PostgreSQL result.
+It owns result shape, not field semantics, authentication, or database effects.
+
+## To boardResultShapeAccepted (columns: Seq of Text, typeOids: Seq of Int, rows: Seq of Seq of Text, nullMask: Seq of Seq of Bool, cmdTag: Text) -> Bool:
+    If (length of columns is equal to 9) is equal to false or (length of typeOids is equal to 9) is equal to false:
+        Return false.
+    Let rowCount be length of rows.
+    If rowCount is greater than 200 or (length of nullMask is equal to rowCount) is equal to false:
+        Return false.
+    If (cmdTag is equal to "SELECT {rowCount}") is equal to false:
+        Return false.
+    Let expectedColumns be ["case_id", "research_kind", "case_state", "control_state", "priority", "live_task_id", "board_phase", "task_state", "title_hex"].
+    Repeat for position from 1 to 9:
+        If (item position of columns is equal to item position of expectedColumns) is equal to false or (item position of typeOids is equal to 25) is equal to false:
+            Return false.
+    Repeat for position from 1 to rowCount:
+        Let row be item position of rows.
+        Let mask be item position of nullMask.
+        If (length of row is equal to 9) is equal to false or (length of mask is equal to 9) is equal to false:
+            Return false.
+        Repeat for isNull in mask:
+            If isNull:
+                Return false.
+    Return true.
+
+## To boardShapeTestColumns () -> Seq of Text:
+    Return ["case_id", "research_kind", "case_state", "control_state", "priority", "live_task_id", "board_phase", "task_state", "title_hex"].
+## To boardShapeTestOids () -> Seq of Int:
+    Return [25, 25, 25, 25, 25, 25, 25, 25, 25].
+## To boardShapeTestRows (count: Int) -> Seq of Seq of Text:
+    Let rows be a new Seq of Seq of Text.
+    Repeat for position from 1 to count:
+        Push ["cell", "cell", "cell", "cell", "cell", "cell", "cell", "cell", "cell"] to rows.
+    Return rows.
+## To boardShapeTestMasks (count: Int) -> Seq of Seq of Bool:
+    Let masks be a new Seq of Seq of Bool.
+    Repeat for position from 1 to count:
+        Push [false, false, false, false, false, false, false, false, false] to masks.
+    Return masks.
+## To boardShapeTestAccepted (rows: Seq of Seq of Text, masks: Seq of Seq of Bool, tag: Text) -> Bool:
+    Return boardResultShapeAccepted(boardShapeTestColumns(), boardShapeTestOids(), rows, masks, tag).
+
+## Test: Board result accepts exact empty and populated shapes
+    Repeat for count in [0, 1, 3, 200]:
+        Expect that boardShapeTestAccepted(boardShapeTestRows(count), boardShapeTestMasks(count), "SELECT {count}") is equal to true.
+
+## Test: Board result requires exact column names and text OIDs
+    Let rows be boardShapeTestRows(1).
+    Let masks be boardShapeTestMasks(1).
+    Repeat for position from 1 to 9:
+        Let mutable columns be boardShapeTestColumns().
+        Set item position of columns to "unexpected".
+        Expect that boardResultShapeAccepted(columns, boardShapeTestOids(), rows, masks, "SELECT 1") is equal to false.
+        Let mutable oids be boardShapeTestOids().
+        Set item position of oids to 23.
+        Expect that boardResultShapeAccepted(boardShapeTestColumns(), oids, rows, masks, "SELECT 1") is equal to false.
+    Let mutable extraColumns be boardShapeTestColumns().
+    Push "extra" to extraColumns.
+    Let mutable extraOids be boardShapeTestOids().
+    Push 25 to extraOids.
+    Expect that boardResultShapeAccepted(extraColumns, boardShapeTestOids(), rows, masks, "SELECT 1") is equal to false.
+    Expect that boardResultShapeAccepted(boardShapeTestColumns(), extraOids, rows, masks, "SELECT 1") is equal to false.
+    Expect that boardResultShapeAccepted(["case_id"], boardShapeTestOids(), rows, masks, "SELECT 1") is equal to false.
+    Expect that boardResultShapeAccepted(boardShapeTestColumns(), [25], rows, masks, "SELECT 1") is equal to false.
+
+## Test: Board result rejects ragged rows and null masks
+    Repeat for width in [0, 8, 10]:
+        Let row be a new Seq of Text.
+        Let mask be a new Seq of Bool.
+        Repeat for position from 1 to width:
+            Push "cell" to row.
+            Push false to mask.
+        Let mutable rows be boardShapeTestRows(1).
+        Set item 1 of rows to row.
+        Expect that boardShapeTestAccepted(rows, boardShapeTestMasks(1), "SELECT 1") is equal to false.
+        Let mutable masks be boardShapeTestMasks(1).
+        Set item 1 of masks to mask.
+        Expect that boardShapeTestAccepted(boardShapeTestRows(1), masks, "SELECT 1") is equal to false.
+    Expect that boardShapeTestAccepted(boardShapeTestRows(1), boardShapeTestMasks(0), "SELECT 1") is equal to false.
+    Expect that boardShapeTestAccepted(boardShapeTestRows(1), boardShapeTestMasks(2), "SELECT 1") is equal to false.
+    Expect that boardShapeTestAccepted(boardShapeTestRows(0), boardShapeTestMasks(1), "SELECT 0") is equal to false.
+
+## Test: Board result rejects every SQL NULL
+    Repeat for position from 1 to 9:
+        Let mutable masks be boardShapeTestMasks(1).
+        Let mutable mask be item 1 of masks.
+        Set item position of mask to true.
+        Set item 1 of masks to mask.
+        Expect that boardShapeTestAccepted(boardShapeTestRows(1), masks, "SELECT 1") is equal to false.
+    For all booleans hasNull:
+        Let mutable masks be boardShapeTestMasks(1).
+        Let mutable mask be item 1 of masks.
+        Set item 9 of mask to hasNull.
+        Set item 1 of masks to mask.
+        Expect that boardShapeTestAccepted(boardShapeTestRows(1), masks, "SELECT 1") is equal to (hasNull is equal to false).
+
+## Test: Board result requires bounded rows and exact command tag
+    Expect that boardShapeTestAccepted(boardShapeTestRows(201), boardShapeTestMasks(201), "SELECT 201") is equal to false.
+    Repeat for tag in ["", "SELECT 0", "SELECT 01", "select 1", "INSERT 0 1", "SELECT 2", "SELECT 1 ", "SELECT +1"]:
+        Expect that boardShapeTestAccepted(boardShapeTestRows(1), boardShapeTestMasks(1), tag) is equal to false.
diff --git a/logos/gateway/target/board-read-contract/src/schema_probe_policy.lg b/logos/gateway/target/board-read-contract/src/schema_probe_policy.lg
new file mode 100644
--- /dev/null
+++ b/logos/gateway/target/board-read-contract/src/schema_probe_policy.lg
@@ -0,0 +1,52 @@
+# MaCSad schema probe policy
+
+This import-free leaf owns the exact dependency probe result shape. A caller
+may become ready only after one typed row reports two columns: schema version
+and PostgreSQL server_version_num. MaCSad schema 1 and PostgreSQL 16 are the
+only versions admitted by this slice.
+
+## To schemaProbeRowCountAccepted (rowCount: Int) -> Bool:
+    Return rowCount is equal to 1.
+
+## To schemaProbeColumnCountAccepted (columnCount: Int) -> Bool:
+    Return columnCount is equal to 2.
+
+## To schemaVersionAccepted (schemaVersion: Int) -> Bool:
+    Return schemaVersion is equal to 1.
+
+## To postgresVersionAccepted (serverVersionNum: Int) -> Bool:
+    If serverVersionNum is less than 160000:
+        Return false.
+    Return serverVersionNum is less than 170000.
+
+## To schemaProbeAccepted (rowCount: Int, columnCount: Int, schemaVersion: Int, serverVersionNum: Int) -> Bool:
+    If schemaProbeRowCountAccepted(rowCount) is equal to false:
+        Return false.
+    If schemaProbeColumnCountAccepted(columnCount) is equal to false:
+        Return false.
+    If schemaVersionAccepted(schemaVersion) is equal to false:
+        Return false.
+    Return postgresVersionAccepted(serverVersionNum).
+
+## Test: Schema probe shape is exact
+    For all booleans exactShape:
+        Let mutable rowCount be 0.
+        Let mutable columnCount be 1.
+        If exactShape:
+            Set rowCount to 1.
+            Set columnCount to 2.
+        Let accepted be schemaProbeAccepted(rowCount, columnCount, 1, 160015).
+        Expect that accepted is equal to exactShape.
+    Expect that schemaProbeAccepted(2, 2, 1, 160015) is equal to false.
+    Expect that schemaProbeAccepted(1, 3, 1, 160015) is equal to false.
+
+## Test: Schema version one is required
+    Expect that schemaProbeAccepted(1, 2, 1, 160015) is equal to true.
+    Expect that schemaProbeAccepted(1, 2, 0, 160015) is equal to false.
+    Expect that schemaProbeAccepted(1, 2, 2, 160015) is equal to false.
+
+## Test: PostgreSQL sixteen is required
+    Expect that schemaProbeAccepted(1, 2, 1, 160000) is equal to true.
+    Expect that schemaProbeAccepted(1, 2, 1, 169999) is equal to true.
+    Expect that schemaProbeAccepted(1, 2, 1, 159999) is equal to false.
+    Expect that schemaProbeAccepted(1, 2, 1, 170000) is equal to false.
diff --git a/host_adapters/tests/board_pg_contract.py b/host_adapters/tests/board_pg_contract.py
new file mode 100644
--- /dev/null
+++ b/host_adapters/tests/board_pg_contract.py
@@ -0,0 +1,226 @@
+"""Isolated, explicit native-board/real-PG16 contract; never ordinary discovery.
+
+Run only through run_board_pg_contract.sh after the root grants the test slot.
+Python supplies fixtures and compares observations; it implements no board policy.
+"""
+
+from __future__ import annotations
+
+import os
+import select
+import socket
+from pathlib import Path
+from unittest import TestCase
+
+from host_adapters.proof_process import run_bounded
+
+
+EVALUATION_ROOT = Path("/tmp/macsad-website-d9-eval.PMwbZo5u")
+WORKSPACE = "10000000-0000-4000-8000-000000000001"
+OTHER_WORKSPACE = "10000000-0000-4000-8000-000000000002"
+CASES = (
+    ("18000000-0000-4000-8000-000000000001", "mathematics", "blocked", "10", "Prior finite sum question"),
+    ("18000000-0000-4000-8000-000000000002", "mathematics", "normal", "80", "Finite sum identity"),
+    ("18000000-0000-4000-8000-000000000003", "computer_science", "paused", "60", "Bounded sort replay"),
+)
+EXPECTED_WIRE = (
+    "macsad-board/1|1|" + WORKSPACE + "\n"
+    + "\n".join(
+        "|".join(("case", case_id, kind, "closed", control, priority, "-", "-", "-", title.encode("utf-8").hex()))
+        for case_id, kind, control, priority, title in CASES
+    ) + "\n"
+).encode("utf-8")
+
+class NativePostgreSQLBoardContract(TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.root = Path(__file__).resolve().parents[2]
+        if cls.root != EVALUATION_ROOT:
+            raise RuntimeError("board contract must run in the exact isolated evaluation checkout")
+        cls.owned = Path(os.environ["MACSAD_BOARD_TEST_ROOT"])
+        if cls.owned.parent != Path("/tmp") or not cls.owned.name.startswith("macsad-board-pg16."):
+            raise RuntimeError("unapproved disposable PostgreSQL root")
+        if cls.owned.is_symlink() or cls.owned.resolve(strict=True) != cls.owned:
+            raise RuntimeError("disposable PostgreSQL root must be canonical")
+        if cls.owned.stat().st_uid != os.getuid() or cls.owned.stat().st_mode & 0o077:
+            raise RuntimeError("disposable PostgreSQL root must be privately owned")
+        cls.port = int(os.environ["MACSAD_BOARD_TEST_PORT"])
+        if not 1024 <= cls.port <= 65535:
+            raise RuntimeError("test port is outside the ephemeral service contract")
+        cls.executable = Path(os.environ["MACSAD_BOARD_EXECUTABLE"])
+        # Keep a missing executable as an explicit RED, never an unavailable skip.
+        if cls.executable.is_symlink() or not cls.executable.is_file():
+            raise RuntimeError("RED: exact compiled native board executable is missing")
+        cls.executable = cls.executable.resolve(strict=True)
+        if not cls.executable.is_relative_to(cls.root):
+            raise RuntimeError("board executable must belong to the isolated MaCSad checkout")
+        if not os.access(cls.executable, os.X_OK):
+            raise RuntimeError("board executable is not executable")
+        cls.pg_bin = Path(os.environ["MACSAD_TEST_PG_BIN"])
+        cls.pg_environment = {
+            "PATH": str(cls.pg_bin) + ":" + os.defpath,
+            "LD_LIBRARY_PATH": os.environ["MACSAD_TEST_PG_LIB"],
+            "PGCONNECT_TIMEOUT": "3", "PGPASSFILE": "/dev/null",
+            "PGOPTIONS": "-c default_transaction_read_only=on -c statement_timeout=10000 -c lock_timeout=1000",
+            "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8",
+        }
+        cls.native_environment = {"PATH": os.defpath, "LANG": "C.UTF-8", "LC_ALL": "C.UTF-8"}
+        cls.url = f"postgresql://macsad_viewer@127.0.0.1:{cls.port}/macsad"
+
+    def sql(self, statement, *, role="macsad_deployer", database="macsad", tcp=False):
+        environment = dict(self.pg_environment)
+        if role == "macsad_viewer":
+            # Observe the real login defaults; do not manufacture read-only
+            # evidence by overriding the viewer's configuration in the test.
+            environment.pop("PGOPTIONS")
+        observation = run_bounded(
+            [str(self.pg_bin / "psql"), "-X", "-w", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1",
+             "-h", "127.0.0.1" if tcp else str(self.owned / "socket"), "-p", str(self.port),
+             "-U", role, "-d", database, "-c", statement],
+            cwd=self.root, environment=environment, timeout_seconds=15,
+        )
+        self.assertEqual(observation.termination, "exited")
+        self.assertEqual(observation.exit_code, 0, observation.stderr.decode("utf-8", errors="replace"))
+        return observation.stdout
+
+    def snapshot(self):
+        # psql -c does not mix SQL and backslash commands. Feed the reviewed
+        # static SQL fixture copied byte-for-byte into this owned root.
+        observation = run_bounded(
+            [str(self.pg_bin / "psql"), "-X", "-w", "-q", "-A", "-t", "-v", "ON_ERROR_STOP=1",
+             "-h", str(self.owned / "socket"), "-p", str(self.port), "-U", "macsad_deployer",
+             "-d", "macsad", "-f", str(self.owned / "snapshot.sql")],
+            cwd=self.root, environment=self.pg_environment, timeout_seconds=15,
+        )
+        self.assertEqual(observation.termination, "exited")
+        self.assertEqual(observation.exit_code, 0, observation.stderr.decode("utf-8", errors="replace"))
+        self.assertEqual(len(observation.stdout.splitlines()), 47)
+        return observation.stdout
+
+    def setUp(self):
+        actual_data = self.sql("SHOW data_directory", role="postgres", database="postgres")
+        self.assertEqual(actual_data, (str(self.owned / "pgdata") + "\n").encode())
+        self.before = self.snapshot()
+
+    def tearDown(self):
+        self.assertEqual(self.snapshot(), self.before, "native read changed database counts, rows, versions or audit state")
+
+    def invoke(self, *arguments):
+        return run_bounded(
+            [str(self.executable), *arguments], cwd=self.root,
+            environment=self.native_environment, timeout_seconds=15,
+        )
+
+    def assert_completed(self, observation, expected):
+        self.assertEqual(observation.termination, "exited")
+        self.assertEqual(observation.exit_code, 0)
+        self.assertEqual(observation.stderr, b"")
+        self.assertEqual(observation.stdout, expected)
+
+    def test_pg16_schema_one_and_restricted_viewer_are_real(self):
+        observed = self.sql(
+            "SELECT current_setting('server_version_num')::integer / 10000, current_user, "
+            "current_setting('transaction_read_only'), (SELECT current_version FROM macsad.schema_version_v), "
+            "rolsuper, rolcreatedb, rolcreaterole, rolreplication, rolbypassrls, "
+            "has_table_privilege(current_user, 'macsad.workspace', 'UPDATE'), "
+            "has_table_privilege(current_user, 'macsad.case_board_v', 'SELECT') "
+            "FROM pg_roles WHERE rolname = current_user;",
+            role="macsad_viewer", tcp=True,
+        )
+        self.assertEqual(observed, b"16|macsad_viewer|on|1|f|f|f|f|f|f|t\n")
+
+    def test_native_read_returns_exact_three_closed_cases_and_is_deterministic(self):
+        first = self.invoke(self.url, WORKSPACE)
+        second = self.invoke(self.url, WORKSPACE)
+        self.assert_completed(first, EXPECTED_WIRE)
+        self.assert_completed(second, EXPECTED_WIRE)
+        self.assertEqual(first.stdout, second.stdout)
+
+    def test_alternate_workspace_is_rejected_before_any_tcp_connection(self):
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as witness:
+            witness.bind(("127.0.0.1", 0))
+            witness.listen(1)
+            rejected_url = f"postgresql://macsad_viewer@127.0.0.1:{witness.getsockname()[1]}/macsad"
+            observed = self.invoke(rejected_url, OTHER_WORKSPACE)
+            self.assert_completed(observed, b"error\n")
+            self.assertEqual(select.select([witness], [], [], 0.1)[0], [], "rejected workspace attempted a TCP connection")
+
+    def test_valid_workspace_connects_but_silent_database_peer_returns_error(self):
+        # Own the listener without accepting or sending a PostgreSQL response.
+        # The native five-second pgConnect limit must fail inside invoke's
+        # fifteen-second process bound, not return a hardcoded fixture board.
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as witness:
+            witness.bind(("127.0.0.1", 0))
+            witness.listen(1)
+            unavailable_url = f"postgresql://macsad_viewer@127.0.0.1:{witness.getsockname()[1]}/macsad"
+            observed = self.invoke(unavailable_url, WORKSPACE)
+            self.assert_completed(observed, b"error\n")
+            self.assertEqual(
+                select.select([witness], [], [], 0.1)[0], [witness],
+                "valid workspace never attempted the required PostgreSQL connection",
+            )
+
+    def test_url_query_options_are_rejected_before_any_tcp_connection(self):
+        # Never silently downgrade requested TLS by ignoring a URL option.
+        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as witness:
+            witness.bind(("127.0.0.1", 0))
+            witness.listen(1)
+            rejected_url = f"postgresql://macsad_viewer@127.0.0.1:{witness.getsockname()[1]}/macsad?sslmode=require"
+            observed = self.invoke(rejected_url, WORKSPACE)
+            self.assert_completed(observed, b"error\n")
+            self.assertEqual(select.select([witness], [], [], 0.1)[0], [], "rejected URL options attempted a TCP connection")
+
+    def test_disallowed_database_urls_return_error(self):
+        # The third column identifies variants whose endpoint is this owned
+        # IPv4 listener. Other loopback host representations only provide
+        # error-protocol evidence here, not proof of no networking elsewhere.
+        # Nonloopback/DNS-external targets and port values that could direct a
+        # defective parser to an unrelated listener belong in pure-policy tests.
+        cases = (
+            ("wrong-role", "postgresql://macsad_deployer@127.0.0.1:{port}/macsad", True),
+            ("password", "postgresql://macsad_viewer:synthetic-test-only@127.0.0.1:{port}/macsad", True),
+            ("leading-zero-port", "postgresql://macsad_viewer@127.0.0.1:0{port}/macsad", True),
+            ("plus-port", "postgresql://macsad_viewer@127.0.0.1:+{port}/macsad", True),
+            ("too-long-leading-zero-port", "postgresql://macsad_viewer@127.0.0.1:" + "0" * 64 + "{port}/macsad", True),
+            ("wrong-database", "postgresql://macsad_viewer@127.0.0.1:{port}/postgres", True),
+            ("trailing-slash", "postgresql://macsad_viewer@127.0.0.1:{port}/macsad/", True),
+            ("empty-query", "postgresql://macsad_viewer@127.0.0.1:{port}/macsad?", True),
+            ("fragment", "postgresql://macsad_viewer@127.0.0.1:{port}/macsad#board", True),
+            ("empty-fragment", "postgresql://macsad_viewer@127.0.0.1:{port}/macsad#", True),
+            ("localhost-dns-host", "postgresql://macsad_viewer@localhost:{port}/macsad", False),
+            ("alternate-loopback-host", "postgresql://macsad_viewer@127.0.0.2:{port}/macsad", False),
+            ("scheme-alias", "postgres://macsad_viewer@127.0.0.1:{port}/macsad", True),
+        )
+        for name, template, observes_endpoint in cases:
+            with self.subTest(case=name):
+                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as witness:
+                    witness.bind(("127.0.0.1", 0))
+                    witness.listen(1)
+                    rejected_url = template.format(port=witness.getsockname()[1])
+                    observed = self.invoke(rejected_url, WORKSPACE)
+                    self.assert_completed(observed, b"error\n")
+                    if observes_endpoint:
+                        self.assertEqual(
+                            select.select([witness], [], [], 0.1)[0], [],
+                            "rejected database URL attempted a TCP connection to the owned endpoint",
+                        )
+
+    def test_missing_or_extra_arguments_are_rejected_before_tcp_connection(self):
+        for name in ("no-arguments", "url-only", "workspace-only", "extra-argument"):
+            with self.subTest(case=name):
+                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as witness:
+                    witness.bind(("127.0.0.1", 0))
+                    witness.listen(1)
+                    url = f"postgresql://macsad_viewer@127.0.0.1:{witness.getsockname()[1]}/macsad"
+                    arguments = {
+                        "no-arguments": (),
+                        "url-only": (url,),
+                        "workspace-only": (WORKSPACE,),
+                        "extra-argument": (url, WORKSPACE, "unexpected"),
+                    }[name]
+                    observed = self.invoke(*arguments)
+                    self.assert_completed(observed, b"error\n")
+                    self.assertEqual(
+                        select.select([witness], [], [], 0.1)[0], [],
+                        "invalid argument count attempted a TCP connection to the owned endpoint",
+                    )
