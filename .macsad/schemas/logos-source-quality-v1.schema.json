{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MaCSad LOGOS source-quality policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "files",
    "scopedCss",
    "duplicateBlocks",
    "markers",
    "debt"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/logos-source-quality-v1.schema.json"
    },
    "schema": {
      "const": "macsad-logos-source-quality/1"
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPhysicalLines",
        "maxLogicalLinesPerDefinition",
        "maxLineLength"
      ],
      "properties": {
        "maxPhysicalLines": { "type": "integer", "minimum": 20, "maximum": 500 },
        "maxLogicalLinesPerDefinition": { "type": "integer", "minimum": 5, "maximum": 500 },
        "maxLineLength": { "type": "integer", "minimum": 80, "maximum": 300 }
      }
    },
    "scopedCss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferredMaxLineLength",
        "hardMaxLineLength",
        "duplicateMinimumDeclarations",
        "maximumIdenticalOccurrences"
      ],
      "properties": {
        "preferredMaxLineLength": { "type": "integer", "minimum": 80, "maximum": 2000 },
        "hardMaxLineLength": { "type": "integer", "minimum": 80, "maximum": 8000 },
        "duplicateMinimumDeclarations": { "type": "integer", "minimum": 4, "maximum": 50 },
        "maximumIdenticalOccurrences": { "const": 1 }
      }
    },
    "duplicateBlocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumStatements",
        "minimumBehaviorStatements",
        "maximumOccurrences"
      ],
      "properties": {
        "minimumStatements": { "type": "integer", "minimum": 4, "maximum": 20 },
        "minimumBehaviorStatements": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maximumOccurrences": { "const": 1 }
      }
    },
    "markers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern", "flags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
          "pattern": { "type": "string", "minLength": 1 },
          "flags": { "enum": ["", "i"] }
        }
      }
    },
    "debt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "fingerprint",
          "locations",
          "reason",
          "removalCondition"
        ],
        "properties": {
          "rule": {
            "enum": [
              "duplicate-scoped-css",
              "scoped-css-preferred-length"
            ]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^logos/[a-z][a-z0-9-]*/src/(?:[a-z0-9_-]+/)*[a-z0-9_-]+\\.lg:[1-9][0-9]*$"
            }
          },
          "reason": { "type": "string", "minLength": 40 },
          "removalCondition": { "type": "string", "minLength": 40 }
        }
      }
    }
  }
}
