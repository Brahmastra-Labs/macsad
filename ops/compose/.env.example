# Generated runtime values belong in .runtime/compose/compose.env, not here.
# This file documents the required non-secret shape only.
MACSAD_BIND_IP=100.64.0.10
MACSAD_REPOSITORY_ROOT=/absolute/path/to/macsad
MACSAD_RUNTIME_DIR=/absolute/path/to/macsad/.runtime/compose
MACSAD_BUILD_DIR=/absolute/path/to/macsad/.runtime/compose/build/0123456789abcdef0123456789abcdef01234567
MACSAD_SECRETS_DIR=/absolute/path/to/macsad/.runtime/compose/secrets
MACSAD_SOURCE_REVISION=0123456789abcdef0123456789abcdef01234567
LOGOS_WORKSPACE=/absolute/path/to/logicaffeine-private
PGADMIN_DEFAULT_EMAIL=owner@example.invalid
